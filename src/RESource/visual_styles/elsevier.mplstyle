# elsevier.mplstyle

# ----------------------------
# Font families
# ----------------------------
font.family : serif
font.serif : Times New Roman, TeX Gyre Termes, Liberation Serif, DejaVu Serif

# Optional: uncomment for sans-serif fallback
# font.family : sans-serif
font.sans-serif : Arial, Liberation Sans, DejaVu Sans, Helvetica, FreeSans

# ----------------------------
# Font sizes (aligned with Elsevier guidelines)
# ----------------------------
font.size : 10                # Default text
axes.titlesize : 12           # Axes title
axes.labelsize : 10           # X/Y axis labels
xtick.labelsize : 9           # X-axis tick labels
ytick.labelsize : 9           # Y-axis tick labels
legend.title_fontsize : 10    # Legend title
legend.fontsize : 9           # Legend labels

# ----------------------------
# Legend styling
# ----------------------------
legend.frameon : False        # Remove legend box/frame

# ----------------------------
# Lines and figure
# ----------------------------
lines.linewidth : 1.2
figure.dpi : 500

# 300 DPI for halftone images; 
# 500 DPI for combination art; 
# 1000 DPI for line art. 72 points in one inch.

figure.figsize : 3.5, 2.5     # Default figure size, single column
# figure.figsize : 7, 5       # Default figure size, double column
