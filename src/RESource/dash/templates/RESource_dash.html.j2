      const has = (o, k) => fin(o[k]);
      const rc = s.cells?.region_col || s.boundary?.name_col || 'region';
      v.innerHTML = '<div id="st-ch" class="morph"></div>';
      /* slide 00: what this store is, the headline numbers, and the running order */
      $('#st-ch').appendChild(el(`<section class="chapter cover" data-no="00" data-name="Overview">
        <div class="eyebrow">${esc(m.country || '')} · scenario ${esc(m.scenario || 'n/a')} · weather year ${m.year || 'n/a'}</div>
        <h1>${esc(st.combined ? st.country : (m.region || st.name))}: from land to a ranked supply curve ${tip(st.combined ? `This view combines ${st.sources.length} regional stores of ${esc(st.country)}: ${st.sources.map((x) => esc(x.region)).join(', ')}. Tables are concatenated and every number is recomputed from the merged tables. Where a table is absent, the chapter says so instead of estimating.` : `Each chapter is computed from one table of ${esc(st.name)}. Where a table is absent, the chapter says so instead of estimating.` + (st.config ? ` Config matched by scenario name: ${esc(st.config.path)}.` : ' No config file matched this scenario; load the scenario YAML with the store to show its assumptions.'))}</h1>
        ${st.combined && st.left.length ? `<div class="banner">Not included: ${st.left.map((x) => `${esc(x.region)} (${x.status === 'error' ? esc(x.error.message) : 'no cells table'})`).join('; ')}.</div>` : ''}
        <div class="grid g4 statrow" id="st-stats"></div>
        <ol class="st-outline" id="st-outline"></ol></section>`));
      const stat = (val, unit, label) => `<div class="card stat in"><div class="v">${val}<small>${unit}</small></div><div class="l">${label}</div></div>`;
      $('#st-stats').innerHTML = [
        s.cells ? stat(F.n(s.cells.n), 'cells', 'ERA5 grid cells in the study area') : '',
        has(so, 'capacity_mw') ? stat(F.n(so.capacity_mw / 1000, 2), 'GW', '<span class="t-solar">Solar</span> potential on developable land') : '',
        has(wi, 'capacity_mw') ? stat(F.n(wi.capacity_mw / 1000, 2), 'GW', '<span class="t-wind">Wind</span> potential on developable land') : '',
        (s.clusters?.solar || s.clusters?.wind) ? stat(F.n((s.clusters.solar?.n || 0) + (s.clusters.wind?.n || 0)), 'clusters', 'Model-ready sites after clustering') : '',
      ].join('');
      const host = $('#st-ch'); let no = 0;
