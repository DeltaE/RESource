<body>
<header class="hdr"><div class="hdr-top">
  <button class="brand" id="brand" title="Stores"><img src="data:image/svg+xml;base64," alt="RESource"><span class="wm"><b>RES</b><span>ource</span><em>DASH 0.3.0</em></span></button>
  <nav class="tabbar">
    <button data-tab="home">Stores</button><button data-tab="studies">Studies</button><button data-tab="story">Story</button><button data-tab="land">Land analytics</button><button data-tab="layers">Layers</button>
    <button data-tab="map">Map</button><button data-tab="supply">Supply</button><button data-tab="cluster">Cluster</button><button data-tab="profiles">Profiles</button>
    <button data-tab="compare">Compare</button><button data-tab="data">Data</button><button data-tab="about">About</button>
  </nav>
  <div class="hdr-right">
    <select id="storeSel" title="Active store"></select>
    <span class="engine" title="In-browser Python engine"><span class="dot" id="engDot" style="background:#6b7686"></span><span id="engText">Python idle</span></span>
    <button class="iconbtn" id="themeBtn"></button>
  </div>
</div></header>
<div id="haircut-notice" class="banner" style="display:none;margin:12px 16px"></div>
<main>
  <section class="view" id="v-home"></section><section class="view" id="v-studies"></section><section class="view" id="v-story"></section><section class="view" id="v-land"></section><section class="view" id="v-layers"></section>
  <section class="view" id="v-map"></section><section class="view" id="v-supply"></section><section class="view" id="v-cluster"></section><section class="view" id="v-profiles"></section>
  <section class="view" id="v-compare"></section><section class="view" id="v-data"></section><section class="view" id="v-about"></section>
</main>
<footer>RESource Dash 0.3.0 · reads RESource <code>.h5</code> stores in the browser with Pyodide · files never leave this computer · Delta E+ Research Group, SFU</footer>
<div class="rd-loader" id="rdLoader" role="status" aria-live="polite" aria-hidden="true"><div class="box"><img src="data:image/svg+xml;base64," alt=""><div class="msg" id="rdLoaderMsg">Loading</div></div></div>
<div class="scrim" id="scrim"><div id="scrimText"></div></div>
<div class="scrim" id="modal"></div>
<div class="rdock" id="rdock" hidden></div>

<script type="application/json" id="py-modules">{{ py_modules_json }}</script>
<script type="text/plain" id="worker-src">/* Pyodide engine. Runs in a Web Worker so the page stays responsive and so stores can
   be mounted with WORKERFS: h5py then reads only the bytes it needs, and a 1 GB store
   is never copied into memory. Python sources arrive in the init message. */
let py = null, S = null, C = null, K = null, mounted = false;
const say = (text) => self.postMessage({ type: 'status', text });

async function init(cfg) {
  importScripts(cfg.pyodideUrl + 'pyodide.js');
  say('Starting Python');
  py = await loadPyodide({ indexURL: cfg.pyodideUrl });
  say('Loading numpy, pandas, h5py');
  await py.loadPackage(['numpy', 'pandas', 'h5py', 'pyyaml', 'shapely']);
  py.FS.mkdirTree('/app');
  for (const [name, src] of Object.entries(cfg.modules)) py.FS.writeFile('/app/' + name, src);
  py.runPython('import os, sys\nos.environ["HDF5_USE_FILE_LOCKING"]="FALSE"\nsys.path.insert(0, "/app")');
  S = py.pyimport('store_summary');
  C = py.pyimport('config_reader');
  K = py.pyimport('cluster_explorer');
  py.FS.mkdirTree('/stores');
  return true;
}

const cmds = {
  init,
  mount({ blobs }) {            // blobs: [{name, data: File}]
    if (mounted) py.FS.unmount('/stores');
    py.FS.mount(py.FS.filesystems.WORKERFS, { blobs }, '/stores');
    mounted = true;
    return blobs.length;
  },
  summarize: ({ name, file }) => S.summarize_store('/stores/' + name, file),
  landImage: ({ name, key }) => S.land_image('/stores/' + name, key),
  cellProfile: ({ name, tech, cell }) => S.cell_profile('/stores/' + name, tech, cell),
  compareCluster: ({ name, tech, clusterId }) => S.cluster_compare('/stores/' + name, tech, clusterId),
  preview: ({ name, key }) => S.table_preview('/stores/' + name, key),
  csv: ({ name, key }) => S.table_csv('/stores/' + name, key),
  recluster: ({ payload }) => K.cluster_cells_json(payload),
  clusterProfiles: ({ name, tech, payload }) => K.cluster_profiles_csv('/stores/' + name, tech, payload),
  combine({ payloads, label }) {
    const d = py.toPy(payloads);
    try { return S.combine_summaries(d, label); } finally { d.destroy(); }
  },
  configs({ texts }) {
    const d = py.toPy(texts);
    try { return C.read_configs(d); } finally { d.destroy(); }
  },
};

self.onmessage = async (e) => {
  const { id, cmd, args } = e.data;
  try {
    const result = await cmds[cmd](args || {});
    self.postMessage({ type: 'done', id, result });
  } catch (err) {
    self.postMessage({ type: 'done', id, error: String(err && err.message || err) });
  }
};
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
/* core: state, helpers, theme, Pyodide engine RPC, file intake, tabs */
const RD = {
  state: { stores: [], groups: {}, configs: [], configErrors: {}, checksums: {}, studies: new Map(), notes: new Map(), studiesDirHandle: null, active: null, tab: 'home', tech: 'solar' },
  views: {}, TECHS: ['solar', 'wind'], LCOE_UNIT: 'USD/MWh',
};
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const tip = (t) => `<span class="tip" tabindex="0" role="note" aria-label="${String(t).replace(/"/g, '&quot;')}" data-tip="${String(t).replace(/"/g, '&quot;')}">i</span>`;
const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const el = (html) => { const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; };
const fin = (v) => v !== null && v !== undefined && Number.isFinite(v);
RD.fmt = {
  n: (v, d = 0) => fin(v) ? v.toLocaleString('en-CA', { minimumFractionDigits: d, maximumFractionDigits: d }) : 'n/a',
  gw: (mw, d) => fin(mw) ? RD.fmt.n(mw / 1000, d ?? (mw < 10000 ? 2 : 1)) + ' GW' : 'n/a',
  pct: (v, d = 1) => fin(v) ? RD.fmt.n(v * 100, d) + '%' : 'n/a',
  cf: (v) => fin(v) ? v.toFixed(3) : 'n/a',
  usd: (v) => fin(v) ? RD.fmt.n(v, 1) + ' ' + RD.LCOE_UNIT : 'n/a',
  mb: (b) => b >= 1e9 ? (b / 1e9).toFixed(2) + ' GB' : (b / 1e6).toFixed(1) + ' MB',
  sig: (v) => !fin(v) ? 'n/a' : Math.abs(v) >= 1000 ? RD.fmt.n(v, 0) : Math.abs(v) >= 10 ? RD.fmt.n(v, 1) : String(+v.toPrecision(3)),
};
RD.find = (id) => RD.state.stores.find((s) => s.id === id) || Object.values(RD.state.groups).find((g) => g.id === id);
RD.active = () => RD.find(RD.state.active);
RD.sum = () => RD.active()?.summary;
RD.subject = (st = RD.active()) => st ? [st.combined ? st.country + ' · ' + st.region : (st.meta.region || st.name), st.meta.scenario, st.meta.year].filter(Boolean) : [];
RD.techName = (t) => t === 'solar' ? 'Solar' : 'Wind';
/* a stable color per weather year, used to tint the stores table so regions sharing a run year read at a glance */
RD.YEAR_HUES = [200, 140, 280, 20, 340, 60, 320, 100];
RD.yearColor = (i) => `hsl(${RD.YEAR_HUES[i % RD.YEAR_HUES.length]} 55% 45%)`;

/* ---------- theme ---------- */
RD.theme = {
  get: () => document.documentElement.dataset.theme,
  set(t) {
    document.documentElement.dataset.theme = t;
    try { localStorage.setItem('rd-theme', t); } catch (e) { /* storage can be unavailable on file:// */ }
    $('#themeBtn').textContent = t === 'dark' ? '☀' : '☾';
    $('#themeBtn').title = t === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
    document.dispatchEvent(new CustomEvent('rd-theme'));
  },
  init() {
    let t = null;
    try { t = localStorage.getItem('rd-theme'); } catch (e) { /* ignore */ }
    this.set(t || 'dark');
    $('#themeBtn').onclick = () => this.set(this.get() === 'dark' ? 'light' : 'dark');
  },
};

/* ---------- logo: art only. The SVG wordmark is hidden and the viewBox cropped to the art,
   so text never overlaps the hexes; the wordmark is HTML in .lockup (theme-aware via CSS) ---------- */
RD.logoFull = function () {
  if (!RD.LOGO_ART) {
    const pre = 'data:image/svg+xml;base64,', svg = atob(RD.LOGO_FULL.slice(pre.length));
    RD.LOGO_ART = pre + btoa(svg.replace('<g class="wm">', '<g class="wm" display="none">').replace('viewBox="0 0 520 520"', 'viewBox="2 -8 516 516"'));
  }
  return RD.LOGO_ART;
};
document.addEventListener('rd-theme', () => $$('img.rd-logo').forEach((im) => { const u = RD.logoFull(); if (im.src !== u) im.src = u; }));

/* ---------- engine ---------- */
RD.engine = {
  worker: null, ready: null, seq: 0, pending: new Map(),
  status(text, cls) { $('#engText').textContent = text; $('#engDot').className = 'dot ' + (cls || 'busy'); },
  start() {
    if (this.ready) return this.ready;
    const src = $('#worker-src').textContent;
    try {
      this.worker = new Worker(URL.createObjectURL(new Blob([src], { type: 'text/javascript' })));
    } catch (e) {
      this.status('worker blocked', 'fail');
      return (this.ready = Promise.reject(new Error('This browser blocked the background worker: ' + e.message)));
    }
    this.worker.onmessage = (e) => {
      const m = e.data;
      if (m.type === 'status') return this.status(m.text);
      const p = this.pending.get(m.id); this.pending.delete(m.id);
      if (p) m.error ? p.reject(new Error(m.error)) : p.resolve(m.result);
    };
    this.worker.onerror = (e) => { this.status('engine error', 'fail'); for (const p of this.pending.values()) p.reject(new Error(e.message || 'worker error')); this.pending.clear(); };
    this.status('Loading Pyodide');
    this.ready = this.call('init', { pyodideUrl: new URL(RD.PYODIDE_URL, location.href).href, modules: JSON.parse($('#py-modules').textContent) }, true)
      .then(() => this.status('Python ready', 'ready'))
      .catch((e) => { this.status('engine failed', 'fail'); throw new Error('Could not start Pyodide (' + e.message + '). The dash needs internet access to ' + RD.PYODIDE_URL + ' on first load.'); });
    return this.ready;
  },
  call(cmd, args, raw) {
    const send = () => new Promise((resolve, reject) => {
      const id = ++this.seq; this.pending.set(id, { resolve, reject });
      this.worker.postMessage({ id, cmd, args });
    });
    return raw ? send() : this.start().then(send);
  },
  async json(cmd, args) { const r = await this.call(cmd, args); return typeof r === 'string' ? JSON.parse(r) : r; },
};

/* ---------- RESource loader API: RDLoader.show("Reading store"); RDLoader.hide(); ---------- */
const RDLoader = (() => {
  const elp = document.getElementById('rdLoader'), msg = document.getElementById('rdLoaderMsg');
  let n = 0, t = 0;
  return {
    show(m = 'Loading') { msg.textContent = m; n++; clearTimeout(t); elp.classList.add('on'); elp.setAttribute('aria-hidden', 'false'); },
    hide(force) { n = force ? 0 : Math.max(0, n - 1); if (n) return; t = setTimeout(() => { elp.classList.remove('on'); elp.setAttribute('aria-hidden', 'true'); }, 120); },
  };
})();
RD.busy = (text) => { text ? RDLoader.show(text) : RDLoader.hide(true); };

/* ---------- intake ---------- */
const NAME_RE = /^resources_([^_]+)_([^_]+)_(.+)_(\d{4})_(\d{8})\.h5$/;
RD.parseName = (n) => { const m = NAME_RE.exec(n); return m ? { country: m[1], region: m[2], scenario: m[3], year: +m[4], run_date: `${m[5].slice(0, 4)}-${m[5].slice(4, 6)}-${m[5].slice(6)}` } : {}; };

async function walkEntry(entry, path, out) {
  if (entry.isFile) { const f = await new Promise((res, rej) => entry.file(res, rej)); out.push({ file: f, rel: path + f.name }); }
  else if (entry.isDirectory) {
    const rd = entry.createReader();
    for (;;) { const batch = await new Promise((res, rej) => rd.readEntries(res, rej)); if (!batch.length) break; for (const e of batch) await walkEntry(e, path + entry.name + '/', out); }
  }
}
RD.intake = async function (items) {      // items: [{file, rel}]
  const st = RD.state, texts = {};
  let added = 0;
  for (const { file, rel } of items) {
    const n = file.name.toLowerCase();
    const studyPath = rel.replace(/\\/g, '/');
    if (/(^|\/)Studies\/notes\/[^/]+\.md$/i.test(studyPath)) {
      st.notes.set(studyPath, { file, rel: studyPath });
      continue;
    }
    if (/(^|\/)Studies\//i.test(studyPath) && (/\.(png|jpe?g|gif|webp)$/i.test(n) || n === 'images.md')) {
      st.studies.set(studyPath, { file, rel: studyPath });
      continue;
    }
    if (/\.(h5|hdf5)$/.test(n)) {
      if (st.stores.some((s) => s.name === file.name && s.size === file.size)) continue;
      st.stores.push({ id: 's' + st.stores.length, mount: 's' + st.stores.length + '.h5', file, name: file.name, rel, size: file.size, meta: RD.parseName(file.name), status: 'new' });
      added++;
    } else if (/\.ya?ml$/.test(n) && !/(^|\/)archived\//i.test(rel)) texts[rel] = await file.text();
    else if (/\.checksums\.json$/.test(n)) { try { st.checksums[file.name.replace(/\.checksums\.json$/i, '')] = JSON.parse(await file.text()); } catch (e) { /* unreadable sidecar: shown as absent */ } }
    /* everything else is skipped */
  }
  for (const s of st.stores) {   // country and region: file name first, else the store/<country>/<region>/ folders
    const dirs = s.rel.replace(/\\/g, '/').split('/').slice(0, -1);
    s.country = s.meta.country || dirs[dirs.length - 2] || 'Unsorted';
    s.region = s.meta.region || dirs[dirs.length - 1] || s.name;
  }
  st.stores.sort((a, b) => a.country.localeCompare(b.country) || a.name.localeCompare(b.name));
  st.groups = {};
  RD.views.home.render();
  if (st.tab === 'studies') RD.views.studies.render();
  if (!added && !Object.keys(texts).length) return;
  try {
    RD.busy('Starting the Python engine (first load downloads about 25 MB)');
    await RD.engine.start();
    if (added) await RD.engine.call('mount', { blobs: st.stores.map((s) => ({ name: s.mount, data: s.file })) });
    if (Object.keys(texts).length) {
      const r = await RD.engine.json('configs', { texts });
      for (const c of r.configs) { st.configs = st.configs.filter((x) => x.path !== c.path); st.configs.push(c); }
      Object.assign(st.configErrors, r.errors);
    }
  } catch (e) { RD.busy(null); RD.views.home.render(e.message); return; }
  RD.busy(null);
  RD.views.home.render();
  if (!RD.state.active && st.stores.length === 1) RD.activate(st.stores[0].id);
};
/* ---------- local database: picked folders, and a cache of read stores ---------- */
RD.db = function () {
  return new Promise((res, rej) => {
    const q = indexedDB.open('resource-dash', 2);
    q.onupgradeneeded = () => { const d = q.result; if (!d.objectStoreNames.contains('kv')) d.createObjectStore('kv'); if (!d.objectStoreNames.contains('payloads')) d.createObjectStore('payloads'); };
    q.onsuccess = () => res(q.result);
    q.onerror = () => rej(q.error);
  });
};
RD.tx = async function (store, mode, fn) {
  try { const d = await RD.db(); return await new Promise((res) => { const t = d.transaction(store, mode), r = fn(t.objectStore(store)); t.oncomplete = () => res(r?.result ?? null); t.onerror = t.onabort = () => res(null); }); }
  catch (e) { return null; }
};

/* Reading a store with Pyodide takes seconds and gives the same answer every time, so the payload is
   kept in IndexedDB against the file's identity (name, size, last modified) and the dash build that
   wrote it. Opening the same store again, in this session or a later one, costs a database read.
   Nothing is fetched twice: the entry is dropped when the file changes or the dash is rebuilt. */
RD.cache = {
  MAX: 24, ok: typeof indexedDB !== 'undefined', hits: 0, misses: 0,
  tag: () => `${RD.VERSION}|${RD.BUILD}`,
  key: (store) => `sum|${store.name}|${store.size}|${store.file?.lastModified ?? 0}|${RD.cache.tag()}`,
  groupKey: (sources) => `grp|${sources.map((x) => RD.cache.key(x)).sort().join('~')}`,
  async get(key) {
    if (!this.ok) return null;
    const e = await RD.tx('payloads', 'readonly', (o) => o.get(key));
    if (!e) { this.misses++; return null; }
    this.hits++;
    RD.tx('payloads', 'readwrite', (o) => o.put({ ...e, at: Date.now() }, key));   // keep the newest in use
    try { return JSON.parse(e.json); } catch (x) { return null; }
  },
  async put(key, payload) {
    if (!this.ok) return;
    const json = typeof payload === 'string' ? payload : JSON.stringify(payload);
    await RD.tx('payloads', 'readwrite', (o) => o.put({ json, bytes: json.length, at: Date.now() }, key));
    this.trim();
  },
  async trim() {   /* keep the most recently used entries only */
    const keys = await RD.tx('payloads', 'readonly', (o) => o.getAllKeys());
    if (!keys || keys.length <= this.MAX) return;
    const rows = await RD.tx('payloads', 'readonly', (o) => o.getAll());
    const old = keys.map((k, i) => [k, rows?.[i]?.at || 0]).sort((a, b) => a[1] - b[1]).slice(0, keys.length - this.MAX);
    await RD.tx('payloads', 'readwrite', (o) => old.forEach(([k]) => o.delete(k)));
  },
  async stats() {
    const rows = await RD.tx('payloads', 'readonly', (o) => o.getAll());
    return { n: rows?.length || 0, bytes: (rows || []).reduce((a, r) => a + (r.bytes || 0), 0) };
  },
  async clear() { await RD.tx('payloads', 'readwrite', (o) => o.clear()); this.hits = this.misses = 0; },
};

/* ---------- reload last ----------
   Browsers cannot reopen a file by its path. Chrome and Edge can keep the handle of a folder or file
   the user picked (File System Access API) in IndexedDB. "Reload last" asks once for read permission
   and reopens the same folder or files, then the last store and tab. Nothing is copied or uploaded. */
RD.session = {
  ok: typeof window.showDirectoryPicker === 'function' && typeof window.indexedDB !== 'undefined',
  handles: [], last: null,
  db: () => RD.db(),
  async idb(mode, fn) { return RD.tx('kv', mode, fn); },
