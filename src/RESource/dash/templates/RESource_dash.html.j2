    },
    render() {
      const v = $('#v-cluster'), s = RD.sum(), me = this, seg = (id, cur, opts) => `<span class="seg" id="${id}">${opts.map(([k, l]) => `<button data-v="${k}" class="${cur === k ? 'on' : ''}">${l}</button>`).join('')}</span>`;
      const lr = me.lcoeRange(), cur = me.max === '' ? (lr ? lr[1] : 0) : +me.max;
      v.innerHTML = `<div class="stage mapstage clstage"><div id="cl-map" class="svgstage"><div class="absent">Clustering</div></div>
        <div class="ovl-title"><div class="eyebrow">Cluster</div><h1>Regroup the cells ${tip('Group the cells by cost, by location, or by a mix of both, then export the clusters. The grouping runs in Python (cluster_explorer.py). The clusters the pipeline stored are left as they are.')}</h1><div class="sub">${esc(RD.subject().join(' · '))}</div></div>
        <div class="mp-left"><div class="ovl-card" id="cl-c">
          <div class="ctl-step"><span class="n">1</span>Group cells by ${tip('k-means (k-means++ start, fixed seed, numpy only) on a feature matrix built per cell: ' +
            '"Cost" uses one column, LCOE minus its mean, divided by its own spread (std. dev.) so the scale is comparable across stores. ' +
            '"Location" uses two columns, lon/lat converted to km (longitude scaled by cos of the mean latitude) and each centred and divided by one shared spread, so north-south and east-west distances count the same; distances are planar, fine for a province or country, not a continent. ' +
            '"Both" blends the two: 0% location weight is cost only, 100% is location only, in between each column is scaled by its share before k-means runs. ' +
            'Clusters are then ranked cheapest-first by their capacity-weighted mean LCOE. This is an exploratory regrouping (cluster_explorer.py) - it does not change the clusters the pipeline wrote to clusters/&lt;tech&gt;.')}</div>
          ${seg('cl-by', me.by, [['cost', 'Cost'], ['geo', 'Location'], ['both', 'Both']])}
          <div id="cl-wl" class="ctl-sub" style="${me.by === 'both' ? '' : 'display:none'}"><input type="range" id="cl-w" min="5" max="95" step="5" value="${me.w}"><span class="small muted">location <span class="mono" id="cl-wv">${me.w}%</span> · cost ${100 - me.w}%</span></div>
          <div class="ctl-step"><span class="n">2</span>Into how many clusters</div>
          <div class="ctl-sub"><input type="range" id="cl-kr" min="1" max="60" value="${Math.min(60, me.k)}"><input class="in" type="number" id="cl-k" min="1" max="80" value="${me.k}"></div>
          <div class="ctl-step"><span class="n">3</span>Counted across</div>
          ${seg('cl-scope', me.scope, [['store', 'Whole area'], ['region', 'Each ' + esc((s.cells?.region_col || 'region').toLowerCase())]])}
          <div class="ctl-step"><span class="n">4</span>Ignore cells above</div>
          ${lr ? `<div class="ctl-sub"><input type="range" id="cl-maxr" min="${lr[0]}" max="${lr[1]}" step="${((lr[1] - lr[0]) / 200) || 1}" value="${cur}"><input class="in" type="number" id="cl-max" min="${Math.floor(lr[0])}" placeholder="none" value="${esc(me.max)}" title="Leave empty for no limit"></div>
          <div class="small muted" id="cl-maxv">${me.max === '' ? 'no limit · pool runs ' + F.n(lr[0], 1) + ' to ' + F.n(lr[1], 1) + ' ' + RD.LCOE_UNIT : 'cells above ' + F.n(+me.max, 1) + ' ' + RD.LCOE_UNIT + ' are left out'}</div>` : '<div class="small muted">No LCOE column for this technology.</div>'}
        </div><div class="ovl-card" id="cl-sum"></div></div>
        <div class="mp-right"><div class="ovl-card" id="cl-leg" style="display:none"></div></div>
        <div id="cl-tech"></div></div>
        <div id="cl-body"></div>`;
      $('#cl-tech').replaceWith(RD.techGlow(() => me.render(), 'cl-tech'));
      $('#cl-by').onclick = (e) => { const x = e.target.dataset?.v; if (x) { me.by = x; me.render(); } };
      $('#cl-scope').onclick = (e) => { const x = e.target.dataset?.v; if (x) { me.scope = x; me.render(); } };
      $('#cl-w').oninput = (e) => { $('#cl-wv').textContent = e.target.value + '%'; };
      $('#cl-w').onchange = (e) => { me.w = +e.target.value; me.run(); };
      const setK = (v) => { me.k = Math.max(1, Math.min(80, Math.round(v) || 1)); $('#cl-k').value = me.k; $('#cl-kr').value = Math.min(60, me.k); me.run(); };
      $('#cl-k').onchange = (e) => setK(+e.target.value);
      $('#cl-kr').onchange = (e) => setK(+e.target.value);
      if (lr) {
        const show = (v) => { $('#cl-maxv').textContent = v === '' ? `no limit · pool runs ${F.n(lr[0], 1)} to ${F.n(lr[1], 1)} ${RD.LCOE_UNIT}` : `cells above ${F.n(+v, 1)} ${RD.LCOE_UNIT} are left out`; };
        const setMax = (v, run) => { me.max = v; $('#cl-max').value = v; $('#cl-maxr').value = v === '' ? lr[1] : v; show(v); if (run) me.run(); };
        $('#cl-maxr').oninput = (e) => { const v = +e.target.value >= lr[1] ? '' : +(+e.target.value).toFixed(2); $('#cl-max').value = v; show(v); };
        $('#cl-maxr').onchange = (e) => setMax(+e.target.value >= lr[1] ? '' : +(+e.target.value).toFixed(2), true);
        $('#cl-max').onchange = (e) => { const x = e.target.value.trim(); setMax(x === '' || +x >= lr[1] ? '' : x, true); };
      }
      me.run();
    },
    async run() {
      const body = $('#cl-body'), id = ++this.seq, p = this.payload(), t = RD.state.tech;
      if (!p) { body.innerHTML = `<div class="absent">Clustering needs <code>x</code>, <code>y</code>, <code>lcoe_${t}</code> and <code>potential_capacity_${t}</code> in the <code>cells</code> table. This store does not hold all four for ${RD.techName(t).toLowerCase()}.</div>`; return; }
      body.classList.add('stale');
      let r;
      try { r = await RD.engine.json('recluster', { payload: JSON.stringify(p) }); }
      catch (e) { r = { error: e.message, crit: true }; }
      if (id !== this.seq || !$('#cl-body')) return;
      body.classList.remove('stale');
      if (r.error) { body.innerHTML = `<div class="banner ${r.crit ? 'crit' : ''}">${esc(r.error)}</div>`; return; }
      this.draw(body, r, p);
    },
    /* the LCOE pool of the active technology bounds the cut-off slider */
    lcoeRange() {
      const v = RD.sum()?.cells?.cols?.['lcoe_' + RD.state.tech];
      if (!v) return null;
      let lo = Infinity, hi = -Infinity;
      for (const x of v) if (fin(x)) { if (x < lo) lo = x; if (x > hi) hi = x; }
      return fin(lo) && hi > lo ? [+lo.toFixed(2), +hi.toFixed(2)] : null;
    },
    mapSvg(r) {
      const s = RD.sum(), W = 900, n = r.info.n_clusters, rings = [...(s.boundary?.rings || []).flat(), ...(s.cells?.rings || []).flat()];
      if (!rings.length || !s.cells?.rings) return null;
      let x0 = 1e9, x1 = -1e9, y0 = 1e9, y1 = -1e9;
      for (const q of rings) for (const p of q) { x0 = Math.min(x0, p[0]); x1 = Math.max(x1, p[0]); y0 = Math.min(y0, p[1]); y1 = Math.max(y1, p[1]); }
      const kx = Math.cos((y0 + y1) / 2 * Math.PI / 180), w = (x1 - x0) * kx, h = y1 - y0, H = Math.min(820, Math.max(320, W * h / w)), sc = Math.min((W - 20) / w, (H - 20) / h);
      const ox = (W - w * sc) / 2, oy = (H - h * sc) / 2, PX = (lon) => ox + (lon - x0) * kx * sc, PY = (lat) => oy + (y1 - lat) * sc;
      const path = (q) => 'M' + q.map((p) => `${PX(p[0]).toFixed(1)} ${PY(p[1]).toFixed(1)}`).join('L') + 'Z';
      let o = `<svg class="ch" viewBox="0 0 ${W} ${H.toFixed(0)}" xmlns="http://www.w3.org/2000/svg">`;
      s.cells.rings.forEach((parts, i) => {
        const c = r.cells[i], col = c && c.cluster ? CH.ramp(n > 1 ? (c.rank - 1) / (n - 1) : 0.5) : null;
        for (const q of parts) o += `<path d="${path(q)}" fill="${col || 'none'}" fill-opacity="${col ? 0.9 : 0}" stroke="var(--line)" stroke-width="0.4" ${col ? '' : 'stroke-dasharray="2 2"'}><title>${esc(s.cells.ids[i])}: ${c && c.cluster ? esc(c.cluster) + ', ' + F.sig(c.lcoe) + ' ' + RD.LCOE_UNIT : 'not clustered'}</title></path>`;
      });
      const multi = !!s.regions?.length;
      for (const parts of (s.boundary?.rings || [])) for (const q of parts) o += `<path d="${path(q)}" fill="none" stroke="var(--ink-2)" stroke-width="${multi ? 0.35 : 0.9}" stroke-opacity="${multi ? 0.45 : 1}"/>`;
      if (multi) o += RD.regionSvg(s, path, PX, PY);
      /* grid reference: drawn on top for orientation only, never part of the clustering */
      const pl = (q) => 'M' + q.map((p) => `${PX(p[0]).toFixed(1)} ${PY(p[1]).toFixed(1)}`).join('L');
      o += RD.grid.svgOverlay(s, PX, PY, 0.55);
      if (n <= 40) for (const c of r.clusters) if (fin(c.lon) && fin(c.lat)) o += `<text class="cl-n" x="${PX(c.lon).toFixed(1)}" y="${(PY(c.lat) + 4).toFixed(1)}" text-anchor="middle">${c.rank}</text>`;
      return o + '</svg>';
    },
    draw(body, r, p) {
      const s = RD.sum(), a = RD.active(), t = RD.state.tech, I = r.info, me = this, U = RD.LCOE_UNIT;
      const tag = `${I.by}_k${I.k}${I.by === 'both' ? '_w' + Math.round(I.cost_weight * 100) : ''}_${I.scope}_${t}`, fname = (kind) => `${kind}_${tag}_${RD.subject().join('_')}`.replace(/[^a-z0-9_.-]+/gi, '_') + '.csv';
      const left = I.n_excluded_no_value + I.n_excluded_over_limit;
      $('#cl-sum').innerHTML = `<p style="margin:0"><b>${I.n_clusters} clusters</b> from ${F.n(I.n_clustered)} of ${F.n(I.n_cells)} cells, ${F.gw(I.capacity_MW)}. ${fin(I.lcoe_variance_kept) ? `The grouping keeps <b>${F.pct(I.lcoe_variance_kept, 0)}</b> of the cell-to-cell LCOE variation.` : ''}
        ${left ? `${F.n(left)} cells are left out: ${F.n(I.n_excluded_no_value)} without capacity or a valid LCOE${I.n_excluded_over_limit ? `, ${F.n(I.n_excluded_over_limit)} above the LCOE limit` : ''}. They are drawn dashed and keep an empty cluster in the export.` : ''}</p>`;
      body.innerHTML = `<div class="grid g2" id="cl-cards"></div><div id="cl-table" style="margin-top:16px"></div>`;
      const cards = $('#cl-cards');
      const stageBox = $('#cl-map'); stageBox.innerHTML = '';
      stageBox.appendChild(CH.card({ title: 'Clusters on the grid', file: 'clusters_map_' + tag, svg: me.mapSvg(r), chips: [RD.techName(t), `k = ${I.k}`, I.by === 'both' ? `cost weight ${Math.round(I.cost_weight * 100)}%` : I.by === 'cost' ? 'by cost' : 'by location'],
        info: 'Colour is the cluster rank, from the cheapest cluster (dark) to the most expensive (yellow). It is an order, not an LCOE scale: two neighbouring colours can be close or far apart in cost. The number marks each cluster at its capacity-weighted centre. Dashed cells took no part.',
        extra: '',
        empty: 'This store holds no cell geometry, so the clusters cannot be drawn. The table and exports below are complete.' }));
      { const mc = stageBox.lastElementChild, leg = $('#cl-leg');
        const legend = () => { leg.style.display = ''; leg.innerHTML = `<div class="cc-head"><h3>Cluster rank</h3></div><div class="ramp" style="background:${CH.rampCss}"></div><div class="small muted" style="display:flex;justify-content:space-between"><span class="mono">1 · cheapest</span><span class="mono">${I.n_clusters} · most expensive</span></div>${RD.grid.has(s) ? RD.grid.legend(s) + `<div class="small muted">Grid layers are for reference ${tip('They are drawn on top for orientation and take no part in the clustering.')}</div>` : ''}`; RD.grid.bind(leg, redraw); };
        const redraw = () => { const svg = me.mapSvg(r); if (svg) $('.cc-body', mc).innerHTML = svg; legend(); };
        legend(); }
      /* supply curves: every clustered cell, the new clusters, and the pipeline's stored clusters */
      const cellRows = r.cells.filter((c) => c.cluster && fin(c.lcoe) && fin(c.capacity_MW)).sort((x, y) => x.lcoe - y.lcoe); let cum = 0;
      const cellPts = cellRows.map((c) => [(cum += c.capacity_MW) / 1000, c.lcoe]);
      const newPts = r.clusters.map((c) => [c.cumulative_MW / 1000, c.lcoe]);
      const oldPts = RD.data.clusterCurve(s, t).map((x) => [x.cum / 1000, x.lcoe]);
      const ys = cellPts.map((q) => q[1]), cap = CH.quant(ys, 0.97) * 1.15, clipped = ys.some((y) => y > cap);
      const series = [{ name: 'Cells', cls: 's-ink', step: true, pts: cellPts }, ...(oldPts.length ? [{ name: 'Stored clusters', cls: 's-old', step: true, pts: oldPts }] : []), { name: 'New clusters', cls: 's-new', step: true, pts: newPts }];
      cards.appendChild(CH.card({ title: 'Supply curve: cells against clusters', file: 'clusters_supply_' + tag, svg: CH.xy({ series, H: 420, xLabel: 'Cumulative capacity (GW)', yLabel: `LCOE proxy (${U})`, xMin: 0, yMax: clipped ? cap : undefined }),
        legend: [['Cells', 'ink-3'], ...(oldPts.length ? [['Stored clusters (pipeline)', 'violet']] : []), ['New clusters', 'accent']], chips: [RD.techName(t)],
        info: 'The grey line is every clustered cell, cheapest first. The bold line is the new clusters, each at its capacity-weighted LCOE. Where the bold steps follow the grey line, the grouping keeps the cost structure. A long flat step across a rising grey line hides expensive cells behind an average.',
        note: (clipped ? `Y axis capped at ${F.n(cap, 0)} ${U}. The most expensive cells run above the frame. ` : '') + (oldPts.length && (I.n_excluded_over_limit || oldPts[oldPts.length - 1][0] * 1000 > I.capacity_MW * 1.02 || oldPts[oldPts.length - 1][0] * 1000 < I.capacity_MW * 0.98) ? 'The stored clusters cover a different set of cells or capacity, so the curves need not end at the same point.' : ''),
        csv: () => [['series', 'cumulative_GW', 'lcoe'], ...series.flatMap((se) => se.pts.map((q) => [se.name, q[0], q[1]]))] }));
      const keys = Object.keys(r.clusters[0] || {}), num = (k, x) => x === null || x === undefined ? '' : typeof x !== 'number' ? esc(x) : k === 'cf_mean' ? F.cf(x) : (k === 'lon' || k === 'lat') ? x.toFixed(3) : Number.isInteger(x) ? F.n(x) : F.sig(x);
      $('#cl-table').innerHTML = `<div class="card"><div class="cc-head"><h3>Clusters, cheapest first <span class="chip">${r.clusters.length}</span></h3><div class="cc-tools"><button class="btn xs" id="cl-x1">Clusters CSV</button><button class="btn xs" id="cl-x2">Cell membership CSV</button><button class="btn xs" id="cl-x3" ${a.combined ? 'disabled title="Hourly profiles are read from one store file. Open a single region to export them."' : ''}>Hourly profiles CSV</button></div></div>
        <div class="scroll" style="max-height:460px"><table class="t"><thead><tr>${keys.map((k) => `<th class="${typeof r.clusters[0][k] === 'number' ? 'r' : ''}">${esc(HEAD[k] || k)}</th>`).join('')}</tr></thead><tbody>
        ${r.clusters.map((c) => `<tr>${keys.map((k) => `<td class="${typeof c[k] === 'number' ? 'r' : ''}" title="${esc(c[k] ?? '')}">${k === 'region' ? esc(String(c[k]).length > 34 ? String(c[k]).slice(0, 32) + '…' : c[k]) : num(k, c[k])}</td>`).join('')}</tr>`).join('')}</tbody></table></div>
        <div class="note">LCOE in ${U}. Cluster LCOE and CF are capacity-weighted means of the member cells, a summary and not a recomputed cost. The exports hold every column as returned by Python, to six significant figures.</div></div>
        <div class="card" style="margin-top:16px"><div class="cc-head"><h3>The same run in Python</h3></div>
        <pre class="code">${esc(`from RESource.dash.cluster_explorer import recluster_store, cluster_profiles

store = "${a.combined ? '<one region store>.h5' : a.name}"
res = recluster_store(store, "${t}", by="${I.by}", k=${I.k}, cost_weight=${I.cost_weight}, scope="${I.scope}", max_lcoe=${I.max_lcoe === null ? 'None' : I.max_lcoe}, seed=${I.seed})
res["clusters"].to_csv("clusters.csv")        # one row per cluster
res["cells"].to_csv("cells.csv")              # cluster of every cell
cluster_profiles(store, "${t}", res["cells"]).to_csv("profiles.csv")   # hourly CF per cluster`)}</pre>
        <div class="note">Method: k-means on scaled location (km) and LCOE, fixed seed, written in numpy. Edit <code>src/RESource/dash/cluster_explorer.py</code>, then run <code>resource-dash</code> to rebuild this page with the change.${a.combined ? ' In a combined view the cells of all regions are clustered together.' : ''}</div></div>`;
      $('#cl-x1').onclick = () => CH.download(fname('clusters'), CH.toCsv(recCsv(r.clusters)), 'text/csv');
      $('#cl-x2').onclick = () => CH.download(fname('cluster_cells'), CH.toCsv(recCsv(r.cells)), 'text/csv');
      $('#cl-x3').onclick = async () => {
        RD.busy('Building hourly cluster profiles');
        try { const x = await RD.engine.json('clusterProfiles', { name: a.mount, tech: t, payload: JSON.stringify(p) }); RD.busy(null); if (x.error) alert(x.error); else CH.download(fname('cluster_profiles'), x.csv, 'text/csv'); }
        catch (e) { RD.busy(null); alert(e.message); }
      };
    },
  };
})();

RD.PYODIDE_URL = "https://cdn.jsdelivr.net/pyodide/v0.27.7/full/"; RD.VERSION = "0.3.0"; RD.BUILD = "2026-11-17-land";
RD.LOGO_FULL = "data:image/svg+xml;base64,";
RD.boot();

</script>
</body>
</html>
