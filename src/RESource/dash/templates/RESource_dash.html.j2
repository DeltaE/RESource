.vleg button svg{flex:none}

/* one technology at a time inside a slide */
.tslot{display:flex;flex-direction:column;gap:8px;min-height:0;width:100%}
.tslot-sw{display:flex;justify-content:flex-end;flex:0 0 auto}
.tslot .grid{min-height:0}
/* the closing slide: what the store does not hold */
#st-ch.morph .chapter.wide{grid-template-columns:1fr;max-width:1120px;margin:0 auto;align-items:center}
.chapter.wide .slot{display:none}
.xlist{list-style:none;margin:14px 0 0;padding:0;columns:2;column-gap:34px;font-size:13.5px;color:var(--ink-2)}
.xlist li{break-inside:avoid;margin:0 0 9px;padding-left:22px;position:relative;line-height:1.5}
.xlist li::before{content:"✕";position:absolute;left:0;top:0;color:var(--crit);font-size:11px;font-weight:700}
@media(max-width:900px){.xlist{columns:1}}
/* cluster controls read as steps */
.ctl-step{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:var(--ink-2);margin:12px 0 6px}
.ctl-step:first-child{margin-top:0}
.ctl-step .n{display:inline-grid;place-items:center;width:17px;height:17px;border-radius:50%;background:var(--surface-2);color:var(--accent-2);font:600 10px var(--f-mono)}
.ctl-sub{display:flex;align-items:center;gap:8px;margin-top:6px}
.ctl-sub input[type=range]{flex:1;min-width:0}
.ctl-sub input[type=number]{width:74px}
#cl-c .seg{display:flex;width:100%}#cl-c .seg button{flex:1}
#v-cluster .clstage{border:0}
#v-cluster .mp-left{top:152px}
#cl-sum{font-size:12.5px;line-height:1.5;color:var(--ink-2)}
/* land analytics tab */

#v-cluster .svgstage{height:100%}#v-cluster .svgstage .card{min-height:0;height:100%;display:flex;flex-direction:column}
/* a slide keeps its card inside the frame, titles and legend included */
#st-ch.morph .slot .grid{overflow:hidden;align-items:stretch}
#st-ch.morph .slot .grid>*{min-height:0;display:flex;flex-direction:column}
#st-ch.morph .slot .card{min-height:0;overflow:hidden;display:flex;flex-direction:column}
#st-ch.morph .slot .cc-body{flex:1 1 auto;min-height:0;overflow:hidden;display:flex;align-items:center;justify-content:center}
#st-ch.morph .slot .cc-head,#st-ch.morph .slot .cc-sub,#st-ch.morph .slot .ramp,#st-ch.morph .slot .note,#st-ch.morph .slot .legend{flex:0 0 auto}
#st-ch.morph .tslot .grid{flex:1 1 auto;min-height:0}
#st-ch.morph .chapter.wide>div:first-child{max-width:none}

/* the shell is one column: header first, then the view, whatever height the header takes.
   Fixed viewport maths broke as soon as the top bar wrapped to a second row. */
body[data-tab="story"]{height:100vh;overflow:hidden;display:flex;flex-direction:column}
body[data-tab="story"] main{flex:1 1 auto;min-height:0;height:auto;display:flex;flex-direction:column}
#v-story.on{flex:1 1 auto;min-height:0;display:flex;flex-direction:column}
/* --hdr is the real header height, set from JS: the top bar wraps on a narrow window */
#v-map .mapstage,#v-cluster .clstage,#v-layers .lystage{height:calc(100vh - var(--hdr) - 34px);min-height:420px}
body.has-dock #v-map .mapstage,body.has-dock #v-cluster .clstage,body.has-dock #v-layers .lystage{height:calc(100vh - var(--hdr) - 98px)}
#v-map .mapstage #map,#v-layers .lystage canvas,#v-cluster .svgstage{height:100%}
#v-cluster .svgstage .card{min-height:0;height:100%}
#st-ch.morph{flex:1 1 auto;min-height:0}
.ovl-card.cellcard{max-height:calc(100% - 210px)}

body[data-tab="story"] main{width:100%;margin:0;align-self:stretch}
body[data-tab="story"] footer{display:none}

#v-story .cc-body{position:relative}
.vramp{position:absolute;right:4px;top:8%;bottom:8%;display:flex;flex-direction:column;align-items:center;gap:5px;width:46px;pointer-events:auto}
.vramp i{flex:1;width:10px;border-radius:5px;min-height:60px}
.vramp span{font-size:10.5px;color:var(--ink-2);text-align:center;line-height:1.1}
.vramp .u{color:var(--ink-3);font-size:10px}
#v-story .cc-body svg.ch{padding-right:44px;box-sizing:border-box}
