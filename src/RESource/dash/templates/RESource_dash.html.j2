  const seg = el(`<span class="seg">${opts.map((t) => `<button data-t="${t}" class="${RD.state.tech === t ? 'on' : ''}">${RD.techName(t)}</button>`).join('')}</span>`);
  seg.onclick = (e) => { const t = e.target.dataset?.t; if (!t) return; RD.state.tech = t; onChange(); };
  return seg;
};

RD.boot = function () {
  RD.theme.init();
  $$('.tabbar button').forEach((b) => (b.onclick = () => RD.go(b.dataset.tab)));
  $('#brand').onclick = () => RD.go('home');
  $('#storeSel').onchange = (e) => e.target.value && RD.activate(e.target.value);
  const fromInput = (inp) => RD.intake([...inp.files].map((f) => ({ file: f, rel: f.webkitRelativePath || f.name })));
  document.addEventListener('change', (e) => { if (e.target.matches('#pickDir,#pickFiles')) { fromInput(e.target); e.target.value = ''; } });
  document.addEventListener('dragover', (e) => { e.preventDefault(); $('#drop')?.classList.add('drag'); });
  document.addEventListener('dragleave', () => $('#drop')?.classList.remove('drag'));
  document.addEventListener('drop', async (e) => {
    e.preventDefault(); $('#drop')?.classList.remove('drag');
    const items = [...(e.dataTransfer.items || [])].filter((i) => i.kind === 'file');
    if (RD.session.ok && items.length && items[0].getAsFileSystemHandle) {   // handles must be requested before any await
      const hp = Promise.all(items.map((i) => i.getAsFileSystemHandle()));
      try { const hs = (await hp).filter(Boolean); if (hs.length) return RD.session.open(hs); } catch (err) { /* fall back to plain files */ }
    }
    const out = [], entries = items.map((i) => i.webkitGetAsEntry?.()).filter(Boolean);
    if (entries.length) for (const en of entries) await walkEntry(en, '', out);
    else for (const f of e.dataTransfer.files) out.push({ file: f, rel: f.name });
    RD.intake(out);
  });
  RD.syncChrome();
  RD.go('home');
  RD.session.load().then((L) => { if (L && RD.state.tab === 'home' && !RD.state.stores.length) RD.views.home.render(); });
};

