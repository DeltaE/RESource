  const V = RD.views.cluster = {
    by: 'both', k: 10, w: 50, scope: 'store', max: '', seq: 0,
    payload() {
      const s = RD.sum(), t = RD.state.tech, c = s.cells, col = (n) => c?.cols[n] || null;
