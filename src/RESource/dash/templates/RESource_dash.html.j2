  /* Study descriptions use "## filename.png" followed by plain-text Markdown. */
  RD.views.studies = {
    urls: [], generation: 0, editing: null,
    async render() {
      const generation = ++this.generation, v = $('#v-studies');
      this.urls.forEach((url) => URL.revokeObjectURL(url));
      this.urls = [];
      const files = RD.state.studies, images = [...files.values()].filter((item) => /\.(png|jpe?g|gif|webp)$/i.test(item.rel)).sort((a, b) => a.rel.localeCompare(b.rel));
      v.innerHTML = `<div class="eyebrow">Studies</div><h1>Study figures</h1>
        <p class="lede">Images and descriptions from the selected Studies folder. They are displayed as saved, independently of any selected store.</p>
        <div id="study-notes"></div>
        <div id="study-gallery"></div>`;
      await this.renderNotes();
      if (!images.length) {
        $('#study-gallery').innerHTML = '<div class="absent">No study images loaded. Open the Studies folder or a parent folder from Stores.</div>';
        return;
      }
      const descriptions = new Map(), errors = [];
      for (const [path, item] of files) {
        if (!/\/images\.md$/i.test(path)) continue;
        try {
          const text = await item.file.text(), sections = new Map(), intro = [];
          let current = null;
          for (const line of text.split(/\r?\n/)) {
            const heading = /^##\s+(.+?)\s*$/.exec(line);
            if (heading) { current = heading[1]; sections.set(current, []); }
            else if (/^#{1,2}\s/.test(line)) current = null;
            else if (current) sections.get(current).push(line);
            else if (!sections.size) intro.push(line);
          }
          descriptions.set(path.slice(0, path.lastIndexOf('/')), { sections, intro: intro.join('\n').trim() });
        } catch (e) { errors.push(`${path}: ${e.message}`); }
      }
      if (generation !== this.generation || RD.state.tab !== 'studies') return;
      const gallery = $('#study-gallery');
      for (const error of errors) gallery.appendChild(el(`<div class="banner crit">Could not read study descriptions: ${esc(error)}</div>`));
      let group = '';
      for (const item of images) {
        const parts = item.rel.split('/'), name = parts.pop();
        let parent = parts.join('/'), description;
        while (parent && !description) {
          description = descriptions.get(parent);
          parent = parent.includes('/') ? parent.slice(0, parent.lastIndexOf('/')) : '';
        }
        const label = parts.join('/');
        if (group !== label) {
          group = label;
          gallery.appendChild(el(`<h2>${esc(label)}</h2>`));
          if (description?.intro) gallery.appendChild(el(`<p style="white-space:pre-wrap">${esc(description.intro)}</p>`));
        }
        const note = description?.sections.get(name)?.join('\n').trim() || 'No description supplied for this image.';
        const url = URL.createObjectURL(item.file); this.urls.push(url);
        const card = el(`<article class="card" style="margin:12px 0;padding:16px"><h3>${esc(name)}</h3><p style="white-space:pre-wrap">${esc(note)}</p><a target="_blank" rel="noopener"><img style="display:block;max-width:100%;max-height:700px;object-fit:contain;background:white" loading="lazy"></a></article>`);
        $('a', card).href = url; $('img', card).src = url; $('img', card).alt = name;
        gallery.appendChild(card);
      }
    },
    /* Notes are freeform Markdown saved as Studies/notes/<timestamp>.md, so they show up here on every later load. */
    async renderNotes() {
      const box = $('#study-notes'); if (!box) return;
      const entries = [...RD.state.notes.entries()].sort((a, b) => b[0].localeCompare(a[0]));
      const editing = this.editing;
      const cards = [];
      for (const [path, item] of entries) {
        const name = path.slice(path.lastIndexOf('/') + 1);
        let text; try { text = await item.file.text(); } catch (e) { text = `(could not read this note: ${e.message})`; }
        const title = /^#\s+(.+)/m.exec(text)?.[1]?.trim() || name;
        cards.push(`<article class="card" style="margin:10px 0;padding:14px">
          <div class="row" style="justify-content:space-between;align-items:baseline"><h3 style="margin:0">${esc(title)}</h3><button class="btn xs" data-edit="${esc(name)}">Edit</button></div>
          <p class="small muted" style="margin:2px 0 8px">${esc(name)}</p>
          <p style="white-space:pre-wrap">${esc(text)}</p></article>`);
      }
      box.innerHTML = `<h2 style="margin-top:22px">Notes ${tip('Freeform notes about this Studies folder, saved as Markdown under Studies/notes/. They stay on this computer and load back automatically.')}</h2>
        <div class="card" style="padding:14px;margin-bottom:4px">
          <textarea id="note-text" rows="6" style="width:100%;box-sizing:border-box;font-family:var(--f-mono)" placeholder="# Note title&#10;&#10;Write something about this study...">${esc(editing?.text ?? '')}</textarea>
          <div class="row" style="margin-top:8px;gap:8px;align-items:center">
            <button class="btn primary" id="note-save">${editing ? 'Save changes' : 'Save note'}</button>
            ${editing ? '<button class="btn" id="note-cancel">Cancel</button>' : ''}
            <span id="note-status" class="small muted"></span>
          </div>
        </div>
        ${cards.join('') || '<div class="absent">No notes yet.</div>'}`;
      $('#note-save').onclick = () => this.saveNote();
      if ($('#note-cancel')) $('#note-cancel').onclick = () => { this.editing = null; this.renderNotes(); };
      $$('button[data-edit]', box).forEach((b) => (b.onclick = async () => {
        const hit = entries.find(([p]) => p.slice(p.lastIndexOf('/') + 1) === b.dataset.edit);
        if (!hit) return;
        this.editing = { name: b.dataset.edit, text: await hit[1].file.text() };
        this.renderNotes();
      }));
    },
    async saveNote() {
      const text = $('#note-text').value, status = $('#note-status');
      if (!text.trim()) { status.textContent = 'Write something before saving.'; return; }
      const name = this.editing?.name || `note_${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, '').replace('T', '_')}.md`;
      status.textContent = 'Saving…';
      try {
        const root = RD.session.handles.find((h) => h.kind === 'directory');
        if (!root) throw new Error('Open a folder (not just files) with "Open folder" so notes can be saved to disk.');
        let perm = await root.queryPermission({ mode: 'readwrite' });
        if (perm !== 'granted') perm = await root.requestPermission({ mode: 'readwrite' });
        if (perm !== 'granted') throw new Error('Write permission was not granted.');
        const studiesDir = RD.state.studiesDirHandle || await root.getDirectoryHandle('Studies', { create: true });
        RD.state.studiesDirHandle = studiesDir;
        const notesDir = await studiesDir.getDirectoryHandle('notes', { create: true });
        const fh = await notesDir.getFileHandle(name, { create: true });
        const w = await fh.createWritable();
        await w.write(text);
        await w.close();
        RD.state.notes.set('Studies/notes/' + name, { file: await fh.getFile(), rel: 'Studies/notes/' + name });
        this.editing = null;
        await this.renderNotes();
      } catch (e) { status.textContent = e.message; }
    },
  };

  /* ---------- story ---------- */
  RD.views.story = {
    render() {
