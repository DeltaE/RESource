/* views: home, story, supply, profiles, compare, data, about (cluster and layers follow in their own blocks) */
(function () {
  const F = RD.fmt, CH = RD.ch, MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const sum = (a) => a.reduce((x, y) => x + (fin(y) ? y : 0), 0);

  /* ---------- shared data shaping ---------- */
  RD.data = {
    /* cost-ordered supply curve from parallel arrays. Items without capacity or a valid LCOE are left out. */
    curve(ids, cap, lcoe, extra) {
      const rows = ids.map((id, i) => ({ id, cap: cap[i], lcoe: lcoe[i], x: extra ? extra(i) : null })).filter((r) => fin(r.cap) && r.cap > 0 && fin(r.lcoe)).sort((a, b) => a.lcoe - b.lcoe);
      let c = 0; for (const r of rows) { c += r.cap; r.cum = c; }
      return rows;
    },
    cellCurve(s, t, region) {
      const c = s.cells; if (!c?.cols['potential_capacity_' + t] || !c.cols['lcoe_' + t]) return [];
      const rows = this.curve(c.ids, c.cols['potential_capacity_' + t], c.cols['lcoe_' + t], (i) => ({ region: c.region?.[i], cf: c.cols[t + '_CF_mean']?.[i] }));
      return region ? this.recum(rows.filter((r) => r.x.region === region)) : rows;
    },
    clusterCurve(s, t, region) {
      const c = s.clusters?.[t]; if (!c?.cols.potential_capacity || !c.cols.lcoe) return [];
      const rows = this.curve(c.ids, c.cols.potential_capacity, c.cols.lcoe, (i) => ({ region: c.region?.[i], cf: c.cols.CF_mean?.[i] }));
      return region ? this.recum(rows.filter((r) => r.x.region === region)) : rows;
    },
    recum(rows) { let c = 0; for (const r of rows) { c += r.cap; r.cum = c; } return rows; },
    byRegion(s, col) {
      const c = s.cells, v = c?.cols[col], out = {}; if (!v || !c.region) return out;
      c.region.forEach((r, i) => { if (fin(v[i])) out[r] = (out[r] || 0) + v[i]; });
      return out;
    },
    /* histogram of `vals` weighted by `w` (or counts) */
    hist(vals, w, nb = 16) {
      const ok = vals.map((v, i) => [v, w ? w[i] : 1]).filter((p) => fin(p[0]) && fin(p[1]) && p[1] > 0); if (!ok.length) return null;
      const lo = Math.min(...ok.map((p) => p[0])), hi = Math.max(...ok.map((p) => p[0])), step = (hi - lo) / nb || 1, bins = new Array(nb).fill(0);
      for (const [v, ww] of ok) bins[Math.min(nb - 1, Math.floor((v - lo) / step))] += ww;
      return { bins, lo, step, cats: bins.map((_, i) => String(+(lo + (i + 0.5) * step).toPrecision(3))) };
    },
  };
  const curvePts = (rows) => rows.map((r) => [r.cum / 1000, r.lcoe]);
  const absent = (what, key) => `<div class="absent">${esc(what)} is not in this store${key ? ` (no <code>${esc(key)}</code> table)` : ''}.</div>`;

  /* ---------- home ---------- */
  /* the Reload last box on the home page: shown until something is opened in this page */
  const reloadBox = () => {
    const S = RD.session, L = S.last;
    if (RD.state.stores.length || !S.ok || !L?.handles?.length) return '';
    const when = new Date(L.savedAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }), v = L.view;
    return `<div class="reload-last"><button class="btn primary" id="reloadLast">↻ Reload last</button>
