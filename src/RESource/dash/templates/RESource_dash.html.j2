        chapter('Grid access', `<p>Cells sit <b>${F.n(a.grid_km_mean, 1)} km</b> on average from the nearest connection point, <b>${F.n(a.grid_km_max, 1)} km</b> at most. Distance is straight-line.</p>
          ${L ? `<p>The grid table holds <b>${F.n(L.n)}</b> features: ${Object.entries(L.kinds).map(([k, n]) => `${F.n(n)} ${esc(k)}`).join(', ')}.</p>` : absent('Grid infrastructure', 'lines')}
          ${has(a, 'grid_connection_cost_per_km') ? `<p>Spur cost in the store: <b>${a.grid_connection_cost_per_km}</b> per km (unit as stored${s.units?.capex ? ', capex unit ' + esc(s.units.capex) : ''}).</p>` : ''}`,
          (() => {
            const gg = el('<div class="grid"></div>');
            const dm = cellMap('nearest_station_distance_km', { pal: 'blues', grid: true, unit: 'km', title: 'Distance to the nearest connection point', info: 'Cells are coloured by straight-line distance to the nearest connection point. The network on top is the grid table: lines by voltage class, nodes as crosses. Dark cells sit close to the grid.' });
            if (dm) gg.appendChild(dm.card);
            if (h) gg.appendChild(CH.card({ title: 'Cells by distance', svg: CH.bars({ cats: h.cats, series: [{ name: 'cells', cls: 's-teal', vals: h.bins }], yLabel: 'Cells (count)', xLabel: 'Distance (km, bin centre)', unit: 'cells', H: 260 }), info: 'Counts of grid cells per distance bin. A long right tail means remote cells that pay a large spur cost in the LCOE proxy.', csv: () => [['distance_km_bin_centre', 'cells'], ...h.cats.map((c, i) => [c, h.bins[i]])] }));
            return gg;
          })());
      }

      /* 6 cost */
      const cc = both((t) => ({ t, rows: RD.data.cellCurve(s, t) })).filter((x) => x.rows.length);
      if (cc.length) {
        const sent = both((t) => S[t].lcoe_sentinel || 0);
        chapter('Cost ranking of cells', `<p>${cc.map(({ t }) => `The cheapest <span class="t-${t}">${t}</span> cell scores <b>${F.usd(S[t].lcoe_min)}</b>. The capacity-weighted mean is <b>${F.usd(S[t].lcoe_wmean)}</b>.`).join(' ')}</p>
          <p>The score is a screening LCOE proxy that includes the grid spur. It ranks sites. It is not an investment price.</p>
          ${sum(sent) ? `<div class="banner">${both((t) => `${S[t].lcoe_sentinel || 0} ${t}`).join(' and ')} cells carry the no-viable-cost marker (LCOE = 999999). They are excluded from every curve and statistic here.</div>` : ''}`,
          techSlot((t) => [cellMap('lcoe_' + t, { pal: 'heat', title: `Cost score per cell · ${RD.techName(t)}`, unit: RD.LCOE_UNIT, info: 'The LCOE proxy per cell, as stored. Dark is cheaper. Cells carrying the 999999 marker are empty. The curve beside it is the same numbers, sorted.' })?.card,
            RD.views.supply.card(cc, 'Cell supply curve', 'cells')]));
      }

      /* 7 clusters */
      const cl = both((t) => ({ t, rows: RD.data.clusterCurve(s, t) })).filter((x) => x.rows.length);
      if (cl.length) {
        chapter('Clusters for planning models', `<p>${cl.map(({ t }) => `Clustering groups <span class="t-${t}">${t}</span> cells into <b>${S[t].clusters}</b> clusters holding <b>${F.gw(S[t].cluster_capacity_mw)}</b>, which is <b>${F.pct(S[t].cluster_capacity_mw / S[t].capacity_mw, 0)}</b> of cell potential.`).join(' ')}</p>
          <p>The gap between cell potential and clustered capacity is capacity dropped by the cluster filters. Check whether that loss is intended before using the clusters in a capacity-expansion model.</p>`,
          RD.views.supply.card(cl, 'Cluster supply curve', 'clusters'));
      } else chapter('Clusters for planning models', absent('Clustered sites', 'clusters/<tech>'));

      /* 8 time */
      const P = s.profiles || {};
      if (P.solar || P.wind) {
        const pk = (t) => MON[P[t].fleet.monthly.indexOf(Math.max(...P[t].fleet.monthly))];
        let r = null;
        if (P.solar && P.wind) { const a = P.solar.fleet.monthly, b = P.wind.fleet.monthly, ma = sum(a) / 12, mb = sum(b) / 12; r = sum(a.map((x, i) => (x - ma) * (b[i] - mb))) / Math.sqrt(sum(a.map((x) => (x - ma) ** 2)) * sum(b.map((x) => (x - mb) ** 2))); }
        chapter('Seasonal shape', `<p>${Object.keys(P).map((t) => `Fleet <span class="t-${t}">${t}</span> output peaks in <b>${pk(t)}</b> with an annual mean capacity factor of <b>${F.cf(P[t].fleet.mean)}</b>.`).join(' ')}</p>
          ${r !== null ? `<p>Monthly solar and wind means correlate at <b>r = ${r.toFixed(2)}</b>. ${r < -0.3 ? 'They complement each other across the year.' : r > 0.3 ? 'They move together, so seasonal complementarity is weak.' : 'The seasonal relationship is weak.'} Twelve points give a rough indication only.</p>` : ''}
          <p class="small">Profiles cover ${esc(P[Object.keys(P)[0]].fleet.start)} to ${esc(P[Object.keys(P)[0]].fleet.end)} (${F.n(P[Object.keys(P)[0]].fleet.hours)} hours), with timestamps as written in the store.</p>`,
          RD.views.profiles.monthlyCard(s));
      } else chapter('Seasonal shape', absent('Hourly cluster profiles', 'timeseries/clusters/<tech>'));

      /* limits */
      const lim = [];
      if (s.missing?.length) lim.push(`Tables absent from this store: ${s.missing.map((k) => `<code>${esc(k)}</code>`).join(', ')}.`);
      for (const [k, p] of Object.entries(s.problems || {})) lim.push(`Table <code>${esc(k)}</code> could not be read: ${esc(p)}.`);
      lim.push('Outlines are thinned for display. Use the store itself for GIS work.', 'Grid distance is straight-line. Line capacity and headroom are not in the store.', 'One weather year is shown. Solar varies more between years than wind in the RESource BC study.');
      chapter('The store does not hold', `<ul class="xlist">${lim.map((l) => `<li>${l}</li>`).join('')}</ul>`, null, 'wide');
      const outline = $('#st-outline'), secs = $$('#st-ch .chapter');
      outline.innerHTML = secs.slice(1).map((c, i) => `<li><button type="button" data-i="${i + 1}"><span class="mono">${esc(c.dataset.no)}</span>${esc(c.dataset.name)}</button></li>`).join('');
      outline.onclick = (e) => { const b = e.target.closest('button'); if (b) RD.story.go(+b.dataset.i, 1); };
    },
  };

  /* a figure RESource rendered and embedded under LandAnalytics/images, shown as stored */
  RD.views.story.laImageCard = function (im, source) {
    const F = RD.fmt, title = `${im.title}${im.source ? ' · ' + im.source : ''}`;
    const card = CH.card({ title, subject: [], chips: ['stored figure', im.content_type, im.bytes < 1024 ? `${im.bytes} bytes` : `${F.n(im.bytes / 1024, 0)} kB`], empty: im.note || ' ',
      info: 'A figure RESource rendered and embedded in the store, with its own legend and colours. The dash shows it as stored.',
      note: `<code>${esc(im.key)}</code>${Object.keys(im.attrs || {}).length ? `<div class="kv" style="margin-top:8px">${Object.entries(im.attrs).map(([k, v]) => `<span>${esc(k)}</span><span>${esc(typeof v === 'object' ? JSON.stringify(v) : v)}</span>`).join('')}</div>` : ''}` });
    const show = (uri) => {
      const body = $('.cc-body', card), a = document.createElement('a'), image = document.createElement('img');
      a.href = uri; a.target = '_blank'; a.rel = 'noopener'; a.title = 'Open full size';
      image.src = uri; image.alt = im.title; image.style.cssText = 'display:block;width:100%;height:auto;max-height:520px;object-fit:contain;border-radius:8px;background:#fff';
      a.appendChild(image); body.replaceChildren(a);
      const b = el('<button class="btn xs">Save</button>'); b.onclick = (e) => { e.stopPropagation(); const a = document.createElement('a'); a.href = uri; a.download = im.name.replace(/[^a-z0-9]+/gi, '_') + '.' + (im.content_type.split('/')[1] || 'png').replace('svg+xml', 'svg'); a.click(); };
      $('.cc-tools', card).appendChild(b);
    };
    if (im.uri) show(im.uri);
    else {
      const body = $('.cc-body', card), button = el('<button class="btn xs">Load image</button>');
      body.appendChild(button);
      button.onclick = async () => {
        button.disabled = true;
        try {
          if (!source?.mount) throw new Error('The source store is not available.');
          const result = await RD.engine.json('landImage', { name: source.mount, key: im.key });
          show(result.uri);
        } catch (e) {
          let error = $('.land-image-error', body);
          if (!error) { error = el('<div class="banner crit land-image-error"></div>'); body.appendChild(error); }
          error.textContent = `Could not load figure: ${e.message}`;
          button.disabled = false;
        }
      };
    }
    return card;
  };

  RD.views.land = {
