          const g = el('<div class="grid"></div>');
          build(cur).filter(Boolean).forEach((c) => g.appendChild(c));
          wrap.appendChild(g);
        };
        draw();
        return wrap;
      };
      const cellMap = (col, o) => {
        const vals = s.cells?.cols?.[col]; if (!vals) return null;
        const mm = CH.minimap(s, vals, o), card = CH.card({ title: o.title, svg: mm?.svg, chips: [col], info: o.info });
        if (mm?.scale && fin(mm.scale.lo)) $('.cc-body', card).appendChild(CH.rampLegendV(mm.scale, o.unit || ''));
        return { mm, card };
      };

      /* 1 where */
      const mm = CH.minimap(s);
      chapter('The study area', `<p>${st.combined ? `The combined view covers <b>${st.sources.length} regions</b> of ${esc(st.country)}.` : `The store covers <b>${esc(m.region || 'n/a')}</b>${m.country ? ` in ${esc(m.country)}` : ''}.`} The boundary table holds <b>${F.n(s.boundary?.n)}</b> ${esc(rc)} units${s.cells ? ` and the grid holds <b>${F.n(s.cells.n)}</b> ERA5 cells` : ''}${has(so, 'area_km2') || has(wi, 'area_km2') ? ` covering <b>${F.n(so.area_km2 ?? wi.area_km2)} km²</b>` : ''}.</p>
        <p>Every later number is attached to one of these cells. Cell IDs carry the unit name and the cell centre, for example <code>${esc(s.cells?.ids[0] || 'n/a')}</code>.</p>`,
