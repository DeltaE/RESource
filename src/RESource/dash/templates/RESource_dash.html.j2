      const chapter = (title, html, cardEl, cls) => { const n2 = String(++no).padStart(2, '0'); const c = el(`<section class="chapter ${cls || ''}" data-no="${n2}" data-name="${esc(String(title).replace(/<[^>]+>/g, ''))}"><div><div class="no">${n2}</div><h2>${title}</h2>${html}</div><div class="slot"></div></section>`); { const tx = c.firstElementChild, blocks = [...tx.children].filter((x) => !x.classList.contains('no') && x.tagName !== 'H2'); if (blocks.length > 1) { const d = el('<details class="more ichap"><summary title="More detail"></summary></details>'); blocks.slice(1).forEach((b) => d.appendChild(b)); tx.appendChild(d); } } if (cardEl) $('.slot', c).appendChild(cardEl); host.appendChild(c); };
      const both = (fn) => RD.TECHS.filter((t) => Object.keys(S[t] || {}).length).map(fn);
      const techs = RD.TECHS.filter((t) => Object.keys(S[t] || {}).length);
      /* a slide that shows one technology at a time: the switch redraws only this slide's cards */
      const techSlot = (build) => {
        const wrap = el('<div class="tslot"></div>');
        let cur = techs.includes(RD.state.tech) ? RD.state.tech : techs[0];
        const draw = () => {
          wrap.innerHTML = '';
          if (techs.length > 1) {
