  RD.views.story.laCard = function (la, s) {
    const cols = la.per_cell ? la.cell_cols : (la.numeric || []);
    const title = `${la.key}${la.source ? ' · ' + la.source : ''}`, chips = [`${F.n(la.rows)} rows × ${F.n(la.cols)} columns`];
    if (!cols.length) return CH.card({ title, chips, empty: la.note || 'This table has no numeric column to draw. Browse it in the Data tab.' });
    const wrap = el('<div></div>');
    const draw = (c) => {
      wrap.innerHTML = ''; let card;
      if (la.per_cell) {
        const mm = CH.minimap(s, s.cells.cols[c]);
        card = CH.card({ title, chips: [...chips, c, 'per cell'], svg: mm?.svg, extra: CH.rampLegend(mm?.scale, ''), info: 'One value per grid cell, as stored. Colour is linear and clamped to the 2nd–98th percentile.' });
      } else {
        const v = la.values[c], items = la.labels.map((l, i) => ({ label: l, val: v[i], cls: 's-teal' })).filter((x) => fin(x.val)).sort((a, b) => b.val - a.val);
        card = CH.card({ title, chips: [...chips, c, `label: ${la.label_col}`], svg: CH.hbars({ items: items.slice(0, 15) }), file: la.key + '_' + c,
          note: `Column total as stored: <span class="mono">${F.sig(la.totals[c])}</span>.${items.length > 15 ? ` Top 15 of ${items.length} rows drawn.` : ''}${la.shown_rows < la.rows ? ` Only the first ${la.shown_rows} rows were read.` : ''}`,
          info: 'Rows ranked by the selected column. Bars share one axis starting at zero. A total is only meaningful if the column is additive.', csv: () => [[la.label_col, ...la.numeric], ...la.labels.map((l, i) => [l, ...la.numeric.map((k) => la.values[k][i])])] });
      }
      if (cols.length > 1) { const sel = el(`<select class="in" style="margin-left:8px">${cols.map((k) => `<option ${k === c ? 'selected' : ''}>${esc(k)}</option>`).join('')}</select>`); sel.onchange = () => draw(sel.value); $('.cc-head h3', card).appendChild(sel); }
      wrap.appendChild(card);
    };
    draw(cols[0]);
    return wrap;
  };

  /* ---------- supply ---------- */
  RD.views.supply = {
    level: 'clusters', region: '',
    card(list, title, level) {
      const marks = list.map(({ t, rows }) => ({ x: rows[rows.length - 1].cum / 1000, y: rows[rows.length - 1].lcoe, text: F.n(rows[rows.length - 1].cum / 1000, 2) + ' GW', cls: 's-' + t, left: true }));
      const ys = list.flatMap((x) => x.rows.map((r) => r.lcoe)), cap = CH.quant(ys, 0.97) * 1.15, clipped = ys.some((y) => y > cap);
      return CH.card({ title, file: title, svg: CH.xy({ series: list.map(({ t, rows }) => ({ name: RD.techName(t), cls: 's-' + t, step: true, pts: curvePts(rows) })), xLabel: 'Cumulative capacity (GW)', yLabel: `LCOE proxy (${RD.LCOE_UNIT})`, xMin: 0, yMax: clipped ? cap : undefined, marks: clipped ? [] : marks }),
        legend: list.map(({ t }) => [RD.techName(t), t]), chips: [level],
        note: clipped ? `Y axis capped at ${F.n(cap, 0)} ${RD.LCOE_UNIT} so the bulk of the curve stays readable. The most expensive ${level} run above the frame; the CSV holds every value.` : '',
        info: 'Sites are sorted from cheapest to most expensive. Read across: the capacity available below a given cost. A flat stretch is a large block of similar sites. A steep end is expensive remainder.',
        csv: () => [['tech', 'id', level === 'cells' ? 'region' : 'region', 'capacity_MW', 'lcoe', 'cf_mean', 'cumulative_MW'], ...list.flatMap(({ t, rows }) => rows.map((r) => [t, r.id, r.x?.region ?? '', r.cap, r.lcoe, r.x?.cf ?? '', r.cum]))] });
    },
    render() {
      const s = RD.sum(), v = $('#v-supply'), me = this;
      if (!s.clusters?.solar && !s.clusters?.wind) me.level = 'cells';
      const regs = [...new Set(s.cells?.region || [])].sort();
      const fn = me.level === 'cells' ? 'cellCurve' : 'clusterCurve';
      const list = RD.TECHS.map((t) => ({ t, rows: RD.data[fn](s, t, me.region) })).filter((x) => x.rows.length);
      v.innerHTML = `<div class="eyebrow">Supply curves</div><h1>What capacity is available below a given cost</h1>
        <div class="controls"><span class="seg" id="su-level">${['clusters', 'cells'].map((l) => `<button data-l="${l}" class="${me.level === l ? 'on' : ''}">${l}</button>`).join('')}</span>
        <label>${esc(s.cells?.region_col || 'Region')} <select class="in" id="su-reg"><option value="">All</option>${regs.map((r) => `<option ${r === me.region ? 'selected' : ''}>${esc(r)}</option>`).join('')}</select></label></div>
        <div id="su-body" class="grid"></div>`;
      $('#su-level').onclick = (e) => { if (e.target.dataset.l) { me.level = e.target.dataset.l; me.render(); } };
      $('#su-reg').onchange = (e) => { me.region = e.target.value; me.render(); };
      const body = $('#su-body');
      if (!list.length) { body.innerHTML = absent(`A ${me.level} supply curve`, me.level === 'cells' ? 'cells with lcoe columns' : 'clusters/<tech>'); return; }
      body.appendChild(me.card(list, `${me.level === 'cells' ? 'Cell' : 'Cluster'} supply curve${me.region ? ' · ' + me.region : ''}`, me.level));
      const rows = list.flatMap(({ t, rows }) => rows.map((r) => ({ t, ...r }))).sort((a, b) => a.lcoe - b.lcoe);
      body.appendChild(el(`<div class="card"><div class="cc-head"><h3>Ranked ${me.level} <span class="chip">${rows.length}</span></h3></div><div class="scroll"><table class="t"><thead><tr><th>#</th><th>Tech</th><th>ID</th><th>${esc(s.cells?.region_col || 'Region')}</th><th class="r">Capacity (MW)</th><th class="r">Mean CF</th><th class="r">LCOE (${RD.LCOE_UNIT})</th></tr></thead><tbody>
        ${rows.slice(0, 400).map((r, i) => `<tr><td class="r">${i + 1}</td><td class="t-${r.t}">${r.t}</td><td class="mono">${esc(r.id)}</td><td>${esc(r.x?.region ?? '')}</td><td class="r">${F.n(r.cap, 1)}</td><td class="r">${F.cf(r.x?.cf)}</td><td class="r">${F.n(r.lcoe, 1)}</td></tr>`).join('')}</tbody></table></div>
        ${rows.length > 400 ? '<div class="note">First 400 rows shown. The CSV export of the chart holds all rows.</div>' : ''}</div>`));
    },
  };

  /* ---------- profiles ---------- */
  RD.views.profiles = {
    site: '',
    monthlyCard(s, site) {
      const P = s.profiles, ts = Object.keys(P), get = (t) => (site && P[t].site[site]) ? P[t].site[site].monthly : P[t].fleet.monthly;
      const use = site ? ts.filter((t) => P[t].site[site]) : ts;
      return CH.card({ title: `Monthly mean capacity factor${site ? ' · ' + site : ' · fleet'}`, svg: CH.bars({ cats: MON, series: use.map((t) => ({ name: RD.techName(t), cls: 's-' + t, vals: get(t) })), yLabel: 'Capacity factor (0 to 1)', unit: '', labels: false }), legend: use.map((t) => [RD.techName(t), t]),
        chips: site ? [] : [use.every((t) => P[t].weighted) ? 'capacity-weighted across clusters' : 'simple mean across clusters'],
        info: 'Bars start at zero, so heights compare honestly. Opposite seasonal peaks indicate complementarity. The fleet value weights each cluster by its potential capacity.', csv: () => [['month', ...use], ...MON.map((mo, i) => [mo, ...use.map((t) => get(t)[i])])] });
    },
    render() {
      const s = RD.sum(), v = $('#v-profiles'), P = s.profiles || {}, me = this, ts = Object.keys(P);
      v.innerHTML = '<div class="eyebrow">Hourly profiles</div><h1>When the resource produces</h1><div class="controls" id="pr-c"></div><div class="grid g2" id="pr-b"></div>';
      if (!ts.length) { $('#pr-b').innerHTML = absent('Hourly cluster profiles', 'timeseries/clusters/<tech>'); return; }
      const t = P[RD.state.tech] ? RD.state.tech : ts[0];
      if (me.site && !P[t].site[me.site]) me.site = '';
      const c = $('#pr-c'); c.appendChild(RD.techSeg(() => me.render()));
      c.appendChild(el(`<label>Cluster <select class="in" id="pr-site"><option value="">Fleet (all clusters)</option>${P[t].ids.map((i) => `<option ${i === me.site ? 'selected' : ''}>${esc(i)}</option>`).join('')}</select></label>`));
      $('#pr-site').onchange = (e) => { me.site = e.target.value; me.render(); };
      const b = $('#pr-b'), dia = me.site ? P[t].site[me.site].diurnal : P[t].fleet.diurnal;
      b.appendChild(me.monthlyCard(s, me.site));
      b.appendChild(CH.card({ title: `Mean day · ${RD.techName(t)}${me.site ? ' · ' + me.site : ' · fleet'}`, svg: CH.xy({ series: [{ name: RD.techName(t), cls: 's-' + t, pts: dia.map((y, h) => [h, y]) }], xLabel: 'Hour of day (store timestamps)', yLabel: 'Capacity factor (0 to 1)', xMin: 0, xMax: 23, yMin: 0, xTicks: [0, 3, 6, 9, 12, 15, 18, 21] }),
        info: 'Average output by hour over the whole year. Hours follow the timestamps written in the store. If the solar peak is not near midday, the store is not in local time.', csv: () => [['hour', 'cf'], ...dia.map((y, h) => [h, y])] }));
      const fl = P[t].fleet;
      if (fl.daily?.length) {
        const d0 = new Date(fl.day0 + 'T00:00:00Z'), nd = fl.daily.length, dayStr = (k) => new Date(d0.getTime() + k * 864e5).toISOString().slice(0, 10);
        const mstarts = [...Array(12).keys()].map((mo) => Math.round((Date.UTC(d0.getUTCFullYear(), mo, 1) - d0.getTime()) / 864e5)).filter((k) => k >= 0 && k < nd);
        const dc = CH.card({ title: `Daily mean · ${RD.techName(t)} · fleet`, svg: CH.xy({ series: [{ name: RD.techName(t), cls: 's-' + t, pts: fl.daily.map((y, k) => [k, y]) }], xLabel: `Day of year (from ${fl.day0})`, yLabel: 'Capacity factor (0 to 1)', xMin: 0, xMax: nd - 1, yMin: 0, xTicks: mstarts }),
          info: 'Mean capacity factor of each day across the year, for the whole fleet. Runs of low days are the periods a system has to cover from elsewhere.', csv: () => [['date', 'cf'], ...fl.daily.map((y, k) => [dayStr(k), y])] });
        dc.style.gridColumn = '1 / -1'; b.appendChild(dc);
        if (fl.hourly?.length) {
          const off = parseInt(String(fl.start).slice(11, 13), 10) || 0;
          if (me.day == null || me.day >= nd) me.day = fl.daily.indexOf(Math.max(...fl.daily.filter(fin)));
          const pc = el('<div id="pr-day"></div>'); b.appendChild(pc);
          const draw = () => {
            const k = me.day, hrs = [...Array(24).keys()].map((h) => fl.hourly[k * 24 + h - off]).map((y) => (fin(y) ? y : null));
            const card = CH.card({ title: `One day · ${RD.techName(t)} · fleet`, svg: CH.xy({ series: [{ name: 'Annual mean day', cls: 's-faint', pts: fl.diurnal.map((y, h) => [h, y]) }, { name: dayStr(k), cls: 's-' + t, pts: hrs.map((y, h) => [h, y]).filter((q) => q[1] !== null) }], xLabel: 'Hour of day (store timestamps)', yLabel: 'Capacity factor (0 to 1)', xMin: 0, xMax: 23, yMin: 0, xTicks: [0, 3, 6, 9, 12, 15, 18, 21] }),
              legend: [['Annual mean day', 'ink-3'], [dayStr(k), t]], chips: [`daily mean ${F.n(fl.daily[k], 3)}`],
              info: 'The hourly fleet output of one date against the annual mean day. Pick any date, or step through days.', csv: () => [['hour', 'cf_' + dayStr(k), 'cf_mean_day'], ...hrs.map((y, h) => [h, y, fl.diurnal[h]])] });
            const ctl = el(`<div class="daypick"><button type="button" class="btn xs" data-s="-1" title="Previous day">◀</button><input class="in" type="date" min="${dayStr(0)}" max="${dayStr(nd - 1)}" value="${dayStr(k)}"><button type="button" class="btn xs" data-s="1" title="Next day">▶</button>
              <button type="button" class="btn xs" data-j="max">Best day</button><button type="button" class="btn xs" data-j="min">Worst day</button></div>`);
            ctl.onclick = (e) => { const st = e.target.dataset?.s, j = e.target.dataset?.j; if (st) me.day = Math.max(0, Math.min(nd - 1, me.day + +st)); else if (j) { const v = fl.daily.filter(fin); me.day = fl.daily.indexOf(j === 'max' ? Math.max(...v) : Math.min(...v)); } else return; draw(); };
            $('input', ctl).onchange = (e) => { const k2 = Math.round((Date.parse(e.target.value + 'T00:00:00Z') - d0.getTime()) / 864e5); if (k2 >= 0 && k2 < nd) { me.day = k2; draw(); } };
            $('.cc-head', card).after(ctl);
            pc.innerHTML = ''; pc.appendChild(card);
          };
          draw();
        }
      } else if (!me.site) b.appendChild(CH.card({ title: 'Daily profiles', empty: 'This summary has no daily series. Re-open the store to compute it.' }));
      const hm = CH.heat({ mat: P[t].fleet.mh, rows: MON, cols: [...Array(24).keys()].map(String), xLabel: 'Hour of day (store timestamps)' });
      const hc = CH.card({ title: `Month by hour · ${RD.techName(t)} · fleet`, svg: hm?.svg, extra: hm ? `<div class="ramp" style="background:${CH.rampCss}"></div><div class="small muted" style="display:flex;justify-content:space-between"><span class="mono">CF ${hm.lo.toFixed(3)}</span><span class="mono">CF ${hm.hi.toFixed(3)}</span></div>` : '', info: 'Each tile is the mean capacity factor for that month and hour. Colour spans the minimum to the maximum of this panel only, so do not compare colours between solar and wind.', csv: () => [['month', ...Array(24).keys()], ...P[t].fleet.mh.map((r, i) => [MON[i], ...r])] });
      hc.style.gridColumn = '1 / -1'; b.appendChild(hc);
      if (me.site) {
        const ph = el('<div class="card"><div class="cc-head"><h3>Before / after this cluster</h3></div><div class="absent">Reading member cells</div></div>');
        ph.id = 'pr-cmp'; b.appendChild(ph);
        me.loadCompare(t, me.site);
      }
    },
    async loadCompare(t, clusterId) {
      const a = RD.active();
      if (a.combined) { const box = $('#pr-cmp'); if (box) box.querySelector('.absent').textContent = 'Not available for a combined, multi-store view — open a single store to compare a cluster to its member cells.'; return; }
      try {
        const r = await RD.engine.json('compareCluster', { name: a.mount, tech: t, clusterId });
        const box = $('#pr-cmp');
        if (!box || this.site !== clusterId) return; // user moved on before this resolved
        if (!r.available) { box.querySelector('.absent').textContent = `No member-cell data for this cluster (missing ${r.missing.join(', ')}).`; return; }
        const memberSeries = r.member_diurnal.map((vals, i) => ({ name: `member ${i + 1}`, cls: 's-faint', pts: vals.map((y, h) => [h, y]) }));
        const repSeries = r.rep_diurnal ? [{ name: `Representative (${clusterId})`, cls: 's-' + t, pts: r.rep_diurnal.map((y, h) => [h, y]) }] : [];
        box.innerHTML = `<div class="cc-head"><h3>Before / after · cluster ${esc(clusterId)}</h3></div><div class="cc-sub"><span class="chip">${r.member_ids.length} member cell${r.member_ids.length === 1 ? '' : 's'}</span>${r.region ? `<span class="chip">${esc(r.region)}</span>` : ''}</div>
          <div class="cc-body">${CH.xy({ series: [...memberSeries, ...repSeries], xLabel: 'Hour of day (store timestamps)', yLabel: 'Capacity factor (0 to 1)', xMin: 0, xMax: 23, yMin: 0, xTicks: [0, 3, 6, 9, 12, 15, 18, 21] })}</div>
          <div class="legend"><span><i style="background:var(--ink-3)"></i>Member cells (before)</span><span><i style="background:var(--${t})"></i>Representative (after)</span></div>
          <div class="note">Member cells capped at ${r.member_ids.length} shown. A cluster whose member lines fan out widely is averaging dissimilar resources into one representative profile.</div>`;
        if (r.member_lcoe && r.member_lcoe.length) {
          const items = r.member_ids.map((id, i) => ({ label: id, val: r.member_lcoe[i], cls: 's-ink' }));
          if (r.cluster_lcoe != null) items.push({ label: `${clusterId} (representative)`, val: r.cluster_lcoe, cls: 's-' + t });
          box.insertAdjacentElement('beforeend', CH.card({ title: `LCOE screening · before vs. after`, svg: CH.hbars({ items, unit: RD.LCOE_UNIT }), info: 'Each bar is one member cell’s own LCOE; the highlighted bar is the cluster’s representative LCOE. Bars spread far apart mean the cluster is screening dissimilar-cost cells together.' }));
        }
      } catch (e) {
        const box = $('#pr-cmp');
        if (box && this.site === clusterId) box.querySelector('.absent').textContent = e.message;
      }
    },
  };

  /* ---------- compare ---------- */
  RD.views.compare = {
    async run() {
      const todo = RD.state.stores.filter((s) => s.status === 'new');
      for (let i = 0; i < todo.length; i++) { RD.busy(`Reading store ${i + 1} of ${todo.length}: ${todo[i].name} (weather year ${todo[i].meta.year ?? 'n/a'})`); try { await RD.ensureSummary(todo[i]); } catch (e) { todo[i].status = 'error'; todo[i].error = { code: 'engine', message: e.message }; } }
      RD.busy(null); this.render(); RD.syncChrome();
    },
    render() {
      const v = $('#v-compare'), st = RD.state, ok = st.stores.filter((s) => s.status === 'ready'), pend = st.stores.filter((s) => s.status === 'new').length, bad = st.stores.filter((s) => s.status === 'error');
      const lab = (s) => [s.meta.region, s.meta.scenario, s.meta.year, s.meta.run_date?.slice(5)].filter(Boolean).join(' · ') || s.name;
      v.innerHTML = `<div class="eyebrow">Compare stores</div><h1>Regions, scenarios and weather years side by side ${tip('Each row is one store. Differences between rows are differences between runs: check the scenario, weather year and run date before reading a change as a finding.')}</h1>
        <div class="controls">${pend ? `<button class="btn primary" id="cmp-run">Read ${pend} unread store${pend === 1 ? '' : 's'}</button>` : ''}<span class="chip">${ok.length} read</span>${bad.length ? `<span class="chip bad">${bad.length} unreadable</span>` : ''}</div><div id="cmp-b" class="grid"></div>`;
      if ($('#cmp-run')) $('#cmp-run').onclick = () => this.run();
      const b = $('#cmp-b');
      if (bad.length) b.appendChild(el(`<div class="banner crit"><b>${bad.length} store${bad.length === 1 ? '' : 's'} could not be read and ${bad.length === 1 ? 'is' : 'are'} left out of this comparison.</b><br>${bad.map((s) => `${esc(s.name)}: ${esc(s.error.message)}`).join('<br>')}</div>`));
      if (!ok.length) { b.appendChild(el('<div class="absent">No store has been read yet.</div>')); return; }
      const g = (s, t, k) => s.summary.story?.[t]?.[k];
      const cols = [['Cells', (s) => F.n(s.summary.cells?.n)], ...RD.TECHS.flatMap((t) => [[`${RD.techName(t)} GW`, (s) => fin(g(s, t, 'capacity_mw')) ? F.n(g(s, t, 'capacity_mw') / 1000, 2) : 'n/a'], [`${RD.techName(t)} developable`, (s) => F.pct(g(s, t, 'developable_share'))], [`${RD.techName(t)} CF`, (s) => F.cf(g(s, t, 'cf_wmean'))], [`${RD.techName(t)} min LCOE`, (s) => fin(g(s, t, 'lcoe_min')) ? F.n(g(s, t, 'lcoe_min'), 1) : 'n/a'], [`${RD.techName(t)} clusters`, (s) => F.n(g(s, t, 'clusters'))]])];
      b.appendChild(el(`<div class="card"><div class="scroll"><table class="t"><thead><tr><th>Store</th>${cols.map((c) => `<th class="r">${c[0]}</th>`).join('')}</tr></thead><tbody>${ok.map((s) => `<tr class="click" data-id="${s.id}"><td>${esc(lab(s))}</td>${cols.map((c) => `<td class="r">${c[1](s)}</td>`).join('')}</tr>`).join('')}</tbody></table></div><div class="note">CF is capacity-weighted. LCOE in ${RD.LCOE_UNIT}. "n/a" means the store has no such column. Click a row to open that store.</div></div>`));
      $$('tr.click', b).forEach((tr) => (tr.onclick = () => RD.activate(tr.dataset.id, 'story')));
      const withCap = ok.filter((s) => RD.TECHS.some((t) => fin(g(s, t, 'capacity_mw'))));
      if (withCap.length > 1) {
        b.appendChild(CH.card({ title: 'Potential capacity by store', subject: [], svg: CH.bars({ cats: withCap.map((s) => (s.meta.region || '') + ' ' + (s.meta.scenario || '').slice(0, 8)), series: RD.TECHS.map((t) => ({ name: RD.techName(t), cls: 's-' + t, vals: withCap.map((s) => fin(g(s, t, 'capacity_mw')) ? g(s, t, 'capacity_mw') / 1000 : null) })), yLabel: 'Potential capacity (GW)', unit: 'GW', labels: true }), legend: RD.TECHS.map((t) => [RD.techName(t), t]),
          info: 'One GW axis for all stores. Regions differ in area, so a taller bar is not a better region. Compare the same region across scenarios to see the effect of an assumption.', csv: () => [['store', 'solar_GW', 'wind_GW'], ...withCap.map((s) => [s.name, ...RD.TECHS.map((t) => fin(g(s, t, 'capacity_mw')) ? g(s, t, 'capacity_mw') / 1000 : '')])] }));
        const CL = ['s-accent', 's-teal', 's-violet', 's-solar', 's-wind', 's-ink'], t = RD.state.tech, ser = withCap.slice(0, 6).map((s, i) => ({ s, cls: CL[i], rows: RD.data.clusterCurve(s.summary, t) })).filter((x) => x.rows.length);
        if (ser.length > 1) {
          const cap = CH.quant(ser.flatMap((x) => x.rows.map((r) => r.lcoe)), 0.95) * 1.2;
          const card = CH.card({ title: `Cluster supply curves · ${RD.techName(t)}`, subject: [], svg: CH.xy({ series: ser.map((x) => ({ name: lab(x.s), cls: x.cls, step: true, pts: curvePts(x.rows) })), xLabel: 'Cumulative capacity (GW)', yLabel: `LCOE proxy (${RD.LCOE_UNIT})`, xMin: 0, yMax: cap }), legend: ser.map((x) => [lab(x.s), x.cls.slice(2) === 'ink' ? 'ink-3' : x.cls.slice(2)]), chips: withCap.length > 6 ? ['first 6 stores'] : [], note: `Y axis capped at ${F.n(cap, 0)} ${RD.LCOE_UNIT}.`,
            info: 'Curves to the right and lower offer more capacity at lower cost. Two curves that overlap exactly are the finding: the changed assumption did not bind.', csv: () => [['store', 'id', 'capacity_MW', 'lcoe', 'cumulative_MW'], ...ser.flatMap((x) => x.rows.map((r) => [x.s.name, r.id, r.cap, r.lcoe, r.cum]))] });
          const seg = RD.techSeg(() => this.render()); if (RD.sum()) $('.cc-head', card).appendChild(seg);
          b.appendChild(card);
        }
      }
    },
  };

  /* ---------- data ---------- */
  function tree(o, depth = 0) {
    if (o === null || typeof o !== 'object') return `<b>${esc(o)}</b>`;
    return Object.entries(o).map(([k, val]) => (val !== null && typeof val === 'object') ? `<details ${depth < 1 ? 'open' : ''}><summary>${esc(k)}</summary>${tree(val, depth + 1)}</details>` : `<div class="leaf">${esc(k)}: <b>${esc(val)}</b></div>`).join('');
  }
  RD.views.data = {
    key: null,
    async show(key) {
      const st = this.src(), box = $('#da-prev'); this.key = key;
      $$('#da-keys tr').forEach((tr) => tr.classList.toggle('sel', tr.dataset.k === key));
      box.innerHTML = '<div class="absent">Reading table</div>';
      try {
        const p = await RD.engine.json('preview', { name: st.mount, key });
        box.innerHTML = `<div class="cc-head"><h3><code>${esc(key)}</code> <span class="chip">${F.n(p.rows)} rows × ${F.n(p.cols)} columns</span></h3><button class="btn xs" id="da-csv">Export CSV</button></div>
          <div class="scroll"><table class="t"><thead><tr>${p.columns.map((c) => `<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${p.body.map((r) => `<tr>${r.map((x) => `<td title="${esc(x)}">${esc(x)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>
          <div class="note">Showing ${p.shown_rows} of ${F.n(p.rows)} rows and ${p.shown_cols} of ${F.n(p.cols)} columns. Values are shown as stored.</div>`;
        $('#da-csv').onclick = async () => { RD.busy('Exporting ' + key); try { const r = await RD.engine.json('csv', { name: st.mount, key }); RD.busy(null); if (r.error) alert(r.error); else CH.download(`${key.replace(/\//g, '_')}_${[st.region, st.meta.scenario, st.meta.year].join('_')}.csv`, r.csv, 'text/csv'); } catch (e) { RD.busy(null); alert(e.message); } };
      } catch (e) { box.innerHTML = '<div class="banner crit"></div>'; RD.brief($('.banner', box), e.message, 220); }
    },
    srcIdx: 0,
    src() { const a = RD.active(); return a.combined ? a.sources[Math.min(this.srcIdx, a.sources.length - 1)] : a; },
    render() {
      const a = RD.active(), st = this.src(), s = st.summary, v = $('#v-data'), cf = a.config;
      v.innerHTML = `<div class="eyebrow">Store contents</div><h1>Every table, as stored</h1>
        ${a.combined ? `<div class="controls"><label>Tables of region <select class="in" id="da-src">${a.sources.map((x, i) => `<option value="${i}" ${x === st ? 'selected' : ''}>${esc(x.region)} · ${esc(x.name)}</option>`).join('')}</select></label><span class="small muted">A combined view has no table of its own. Each region's store is browsed separately.</span></div>` : ''}
        <div class="grid" style="grid-template-columns:330px minmax(0,1fr)"><div class="card"><div class="scroll" style="max-height:520px"><table class="t" id="da-keys"><thead><tr><th>Key</th><th class="r">Rows</th><th class="r">Cols</th></tr></thead><tbody>
        ${s.keys.map((k) => `<tr class="click" data-k="${esc(k.key)}"><td class="mono">${esc(k.key)}</td><td class="r">${F.n(k.rows)}</td><td class="r">${F.n(k.cols)}</td></tr>`).join('')}</tbody></table></div></div><div class="card" id="da-prev"></div></div>
        ${laList(s)}<div class="grid g2" style="margin-top:16px">
          <div class="card"><div class="cc-head"><h3>Units table</h3></div>${s.units ? `<div class="kv">${Object.entries(s.units).map(([k, u]) => `<span>${esc(k)}</span><span>${esc(u)}</span>`).join('')}</div><div class="note">Shown exactly as stored in <code>units</code>. This dash labels LCOE as ${RD.LCOE_UNIT}; the stored entry <code>p_lcoe</code> reads differently. Confirm the intended unit in RESource.</div>` : absent('A units table', 'units')}</div>
          <div class="card"><div class="cc-head"><h3>Scenario config</h3></div>${cf ? `<div class="cc-sub"><span class="chip">${esc(cf.path)}</span>${cf.chain.length > 1 ? `<span class="chip">extends ${esc(cf.chain.slice(0, -1).join(' → '))}</span>` : ''}${cf.missing_parents.length ? `<span class="chip warn">parent not loaded: ${esc(cf.missing_parents.join(', '))}</span>` : ''}</div><div class="tree scroll" style="max-height:440px;padding:8px">${tree(cf.config)}</div>` : `<div class="absent">No loaded config has <code>Scenario.run_id</code> equal to <code>${esc(st.meta.scenario || '')}</code>. ${RD.state.configs.length ? 'Loaded run IDs: ' + [...new Set(RD.state.configs.map((c) => esc(c.run_id)))].join(', ') + '.' : 'No config files are loaded.'}</div>`}</div></div>${runCard(st)}`;
      if ($('#da-src')) $('#da-src').onchange = (e) => { this.srcIdx = +e.target.value; this.render(); };
      $$('#da-keys tr.click').forEach((tr) => (tr.onclick = () => this.show(tr.dataset.k)));
      this.show(s.keys.some((k) => k.key === this.key) ? this.key : s.keys[0].key);
    },
  };

  /* land analytics datasets that are not tables: listed so nothing in the store is hidden */
  function laList(s) {
    const m = s.la_media; if (!m || !(m.images.length + m.other.length)) return '';
    const row = (k, kind, size, extra) => `<tr><td class="mono">${esc(k)}</td><td>${kind}</td><td class="r mono">${size}</td><td>${extra}</td></tr>`;
    return `<div class="card" style="margin-top:16px"><div class="cc-head"><h3>Land analytics datasets <span class="chip">${m.images.length + m.other.length}</span></h3></div>
      <div class="scroll" style="max-height:320px"><table class="t"><thead><tr><th>Key</th><th>Kind</th><th class="r">Size</th><th>Note</th></tr></thead><tbody>
      ${m.images.map((im) => row(im.key, 'figure', im.bytes < 1024 ? im.bytes + ' bytes' : RD.fmt.n(im.bytes / 1024, 0) + ' kB', esc(im.content_type) + ' · shown in Land analytics')).join('')}
      ${m.other.map((x) => row(x.key, x.shape.length === 2 ? 'raster' : 'dataset', `${x.shape.join(' × ')} ${esc(x.dtype)}`, (x.units ? 'units ' + esc(x.units) + ' · ' : '') + 'listed, not drawn')).join('')}
      </tbody></table></div><div class="note">These datasets are not pandas tables, so they have no row preview.</div></div>`;
  }

  /* run record: the _meta group of the store, plus the checksums sidecar when it was supplied */
  function runCard(st) {
    const m = st.summary.run, ck = RD.state.checksums[st.name.replace(/\.(h5|hdf5)$/i, '')];
    const head = '<div class="cc-head"><h3>Run record</h3></div>';
    if (!m && !ck) return `<div class="card" style="margin-top:16px">${head}${absent('A run record', '_meta')}<div class="note">RESource 2025.7 and later write the run ID, code version, package versions and the resolved config into <code>_meta</code>. This store predates that. Load its <code>.checksums.json</code> file with the store to list the step checksums.</div></div>`;
    const rt = m?.runtime || {}, pv = m?.config_provenance || {}, hw = rt.hardware || {};
    const kv = (rows) => `<div class="kv">${rows.filter((r) => r[1] !== undefined && r[1] !== null && r[1] !== '').map(([k, x]) => `<span>${esc(k)}</span><span title="${esc(x)}">${esc(x)}</span>`).join('')}</div>`;
    const short = (x) => String(x || '').slice(0, 12), base = (p) => String(p || '').split(/[\\/]/).pop();
    const shown = ['runtime', 'config', 'config_provenance', 'run_id', 'country', 'region_short_code', '_meta_updated_at'];
    const other = Object.entries(m || {}).filter(([k, x]) => !shown.includes(k) && typeof x !== 'object');
    const col = (title, body) => `<div><div class="eyebrow" style="margin-bottom:6px">${esc(title)}</div>${body}</div>`;
    return `<div class="card" style="margin-top:16px">${head}
      <div class="cc-sub">${m ? `<span class="chip">_meta</span>` : ''}${ck ? '<span class="chip">checksums.json</span>' : ''}${rt.git_dirty ? '<span class="chip warn" title="git_dirty is true in the run record">code had uncommitted changes at run time</span>' : ''}</div>
      <div class="grid g3">
      ${m ? col('Run', kv([['run_id', m.run_id], ['country', m.country], ['region', m.region_short_code], ['created', rt.created_at], ['meta updated', m._meta_updated_at], ['RESource', rt.RESource_version], ['git commit', short(rt.git_commit)], ['host', rt.hostname], ...other])) : ''}
      ${m && (rt.package_versions || hw.python) ? col('Environment', kv([['python', hw.python], ['platform', hw.platform], ['cpu logical', hw.cpu_logical], ['ram GB', hw.ram_total_gb], ...Object.entries(rt.package_versions || {})])) : ''}
      ${m && pv.sources ? col('Config sources', kv(pv.sources.map((x) => [base(x.path), 'sha256 ' + short(x.sha256)])) + (pv.override_paths?.length ? `<div class="note">Keys the scenario overrides: ${pv.override_paths.map((x) => `<code>${esc(x)}</code>`).join(', ')}</div>` : '')) : ''}
      ${ck ? col('Step checksums', kv(Object.entries(ck).map(([k, x]) => [k, short(x)]))) : ''}
      </div><div class="note">Shown as stored. Hashes are cut to 12 characters. ${m ? 'The Scenario config card above shows the config embedded in this record.' : ''}${ck ? '' : ' Load the <code>.checksums.json</code> file next to the store to list its step checksums.'}</div></div>`;
  }

  /* ---------- about ---------- */
/* ---------- help: quick reference and a guided tour of the live interface ---------- */
  /* the guided tour lives in About; it points at the live interface rather than a recording */
  RD.tour = {
    voice: (() => { try { return localStorage.getItem('rd-tour-voice') !== '0'; } catch (e) { return true; } })(),
    i: 0, timer: 0, on: false, paused: false, steps: [],
    STEPS: [
      { sel: '#brand', home: true, text: 'This is RESource Dash. Click the logo at any time to return to your stores.' },
      { sel: '#drop', home: true, text: 'Start here. Open a folder that holds your store directory, or drop stores and config files on this box.' },
      { sel: '.reload-last', home: true, text: 'Reload last reopens the folder you used before, then returns to the same store and tab.' },
      { sel: '.tabbar button[data-tab="story"]', text: 'Story walks one run from land, to resource, to grid, to cost, to clusters.' },
      { sel: '.tabbar button[data-tab="land"]', text: 'Land analytics shows the land maps, class distributions and layer-impact figures stored in the run.' },
      { sel: '.tabbar button[data-tab="layers"]', text: 'Layers stacks the spatial layers behind a ranked site.' },
      { sel: '.tabbar button[data-tab="map"]', text: 'Map draws cells, boundaries and grid lines. Click a voltage class in its legend to hide or show it.' },
      { sel: '.tabbar button[data-tab="supply"]', text: 'Supply ranks capacity from cheapest to most expensive.' },
      { sel: '.tabbar button[data-tab="cluster"]', text: 'Cluster regroups the cells into your own clusters and exports their profiles.' },
      { sel: '.tabbar button[data-tab="profiles"]', text: 'Profiles shows when the resource produces, by hour and by season.' },
      { sel: '.tabbar button[data-tab="compare"]', text: 'Compare puts regions, scenarios and weather years side by side.' },
      { sel: '.tabbar button[data-tab="data"]', text: 'Data lists every table and layer in the store, with CSV export.' },
      { sel: '#storeSel', text: 'Switch the active store here once several are open.' },
      { sel: '.engine', text: 'This light shows the Python engine that reads stores inside your browser.' },
      { sel: '#themeBtn', text: 'Switch between light and dark.' },
      { sel: '.tabbar button[data-tab="about"]', text: 'Replay this tour from About at any time.' },
    ],
    visible(sel) { const e = $(sel); if (!e) return null; const r = e.getBoundingClientRect(); return r.width && r.height && getComputedStyle(e).visibility !== 'hidden' ? e : null; },
    start() {
      this.stop(true);
      if (RD.state.tab !== 'home') RD.go('home');
      this.steps = this.STEPS.filter((s) => this.visible(s.sel));
      if (!this.steps.length) return;
      this.on = true; this.paused = false; this.i = 0;
      const ov = el(`<div class="tour" role="dialog" aria-live="polite" aria-label="Guided tour"><div class="tour-spot"></div>
        <div class="tour-cap"><div class="tour-text"></div><div class="tour-bar"><i></i></div>
        <div class="tour-ctl"><button data-a="prev" title="Previous (←)">◀</button><button data-a="pause" title="Pause (space)">❚❚</button><button data-a="next" title="Next (→)">▶</button>
        <span class="tour-n"></span><button data-a="stop" title="Close (Esc)">✕</button></div></div></div>`);
      document.body.appendChild(ov);
      ov.onclick = (e) => { const a = e.target.dataset?.a; if (a === 'prev') this.go(this.i - 1); if (a === 'next') this.go(this.i + 1); if (a === 'pause') this.pause(); if (a === 'stop') this.stop(); };
      this.key = (e) => { if (!this.on) return; if (e.key === 'Escape') this.stop(); else if (e.key === 'ArrowRight') this.go(this.i + 1); else if (e.key === 'ArrowLeft') this.go(this.i - 1); else if (e.key === ' ') { e.preventDefault(); this.pause(); } };
      this.fit = () => this.on && this.place();
      document.addEventListener('keydown', this.key); window.addEventListener('resize', this.fit);
      this.go(0);
    },
    place() {
      const s = this.steps[this.i], e = $(s.sel), ov = $('.tour'); if (!e || !ov) return;
      const r = e.getBoundingClientRect(), pad = 6, spot = $('.tour-spot', ov), cap = $('.tour-cap', ov);
      Object.assign(spot.style, { left: r.left - pad + 'px', top: r.top - pad + 'px', width: r.width + 2 * pad + 'px', height: r.height + 2 * pad + 'px' });
      const cw = Math.min(380, innerWidth - 24), below = r.bottom + 14 + 150 < innerHeight;
