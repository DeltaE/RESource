<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="Md Eliasinul Islam (Elias)">
<meta name="generator" content="RESource Dash 0.3.0 (build.py, 2026-11-16)">
<title>RESource Dash</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
/* RESource Dash. Tokens follow the RESource logo (navy, teal, leaf green) and the
   RESource presentation deck (Inter, JetBrains Mono, near-black dark theme). */
:root{
  --hdr:56px;
  --bg:#f3f6fa; --surface:#ffffff; --surface-2:#eaf0f6; --line:#d3dde8; --line-soft:#e4ebf2;
  --ink:#16202e; --ink-2:#516074; --ink-3:#7d8a9a;
  --accent:#0d4c81; --accent-2:#2c9a48; --glow:#1f8fe0;
  --solar:#c08a00; --wind:#1b74c4; --teal:#25777b; --violet:#6b58c8;
  --good:#1d8a43; --warn:#a8720c; --crit:#b3372c; --warn-bg:#fff7e6; --crit-bg:#fdf0ee;
  --shadow:0 1px 2px rgba(13,30,55,.05),0 4px 14px rgba(13,30,55,.06);
  --f-ui:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --f-mono:'JetBrains Mono',ui-monospace,Consolas,monospace;
  color-scheme:light;
}
:root[data-theme="dark"]{
  --bg:#000000; --surface:#0b0c0f; --surface-2:#14161b; --line:#23262e; --line-soft:#17191e;
  --ink:#eef2f7; --ink-2:#9aa5b2; --ink-3:#6b7686;
  --accent:#62b2f2; --accent-2:#3bb54a; --glow:#1f8fe0;
  --solar:#f4cf12; --wind:#4aa8ee; --teal:#16c0b0; --violet:#8f7ae6;
  --good:#4fd07a; --warn:#f0a027; --crit:#f0705e; --warn-bg:#241c0e; --crit-bg:#2a1512;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 6px 18px rgba(0,0,0,.3);
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:var(--f-ui);background:var(--bg);color:var(--ink);font-size:14px;line-height:1.5}
a{color:var(--accent)}
code,.mono{font-family:var(--f-mono);font-size:.92em}
button{font-family:inherit}

/* header: always the dark RESource field, so the mark and tabs read the same in both themes */
.hdr{position:sticky;top:0;z-index:1000;color:#fff;padding:8px 22px;
  background:linear-gradient(140deg,#04121f 0%,#0a3156 48%,#0d4c81 74%,#17726c 100%);
  border-bottom:2px solid #8cc63f;box-shadow:0 2px 14px rgba(0,16,32,.3)}
.hdr-top{display:flex;align-items:center;gap:14px;flex-wrap:wrap;min-height:44px}
.brand{display:flex;align-items:center;gap:10px;background:none;border:0;color:inherit;cursor:pointer;padding:0}
.brand img{height:40px;width:40px;object-fit:contain}
.wm{font-size:21px;font-weight:800;letter-spacing:.01em;line-height:1}
.wm b{color:#fff}.wm span{color:rgba(255,255,255,.62);font-weight:600}
.wm em{font-style:normal;font-family:var(--f-mono);font-size:10px;font-weight:600;letter-spacing:.08em;
  margin-left:8px;padding:2px 8px;border:1px solid rgba(255,255,255,.25);border-radius:10px;color:rgba(255,255,255,.7);vertical-align:middle}
.tabbar{display:flex;gap:2px;margin-left:6px;padding-left:14px;border-left:1px solid rgba(255,255,255,.16);flex-wrap:wrap}
.tabbar button{position:relative;background:none;border:0;color:rgba(255,255,255,.45);padding:6px 10px;font-size:13px;
  font-weight:500;cursor:pointer;transition:color .2s}
.tabbar button:hover{color:rgba(255,255,255,.82)}
.tabbar button.on{color:#fff;font-weight:700}
.tabbar button.on::after{content:'';position:absolute;left:10px;right:10px;bottom:0;height:2px;border-radius:2px;
  background:#8cc63f;box-shadow:0 0 4px #8cc63f,0 0 11px rgba(140,198,63,.55)}
.tabbar button:disabled{opacity:.35;cursor:not-allowed}
.hdr-right{margin-left:auto;display:flex;align-items:center;gap:10px}
.hdr select{max-width:330px;background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.2);
  border-radius:8px;padding:6px 8px;font-size:12.5px;font-family:inherit}
.hdr select option{color:#16202e}
.iconbtn{width:34px;height:34px;border-radius:9px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.16);
  color:rgba(255,255,255,.8);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.iconbtn:hover{background:rgba(255,255,255,.14);color:#fff}
.engine{font-size:11.5px;color:rgba(255,255,255,.7);display:flex;align-items:center;gap:6px;font-family:var(--f-mono)}
.dot{width:8px;height:8px;border-radius:50%;background:#f0a027}
.dot.ready{background:#8cc63f;box-shadow:0 0 6px #8cc63f}.dot.fail{background:#f0705e}
.dot.busy{animation:pulse 1s infinite}@keyframes pulse{50%{opacity:.3}}

main{max-width:1280px;margin:0 auto;padding:20px 22px 70px}
.view{display:none}.view.on{display:block}
h1{font-size:30px;line-height:1.15;margin:0 0 8px;font-weight:800;letter-spacing:-.02em}
h2{font-size:19px;margin:0 0 6px;font-weight:700;letter-spacing:-.01em}
.eyebrow{font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-2);font-weight:600}
.lede{font-size:15.5px;color:var(--ink-2);max-width:78ch}
.muted{color:var(--ink-2)}.small{font-size:12.5px}
.num{font-family:var(--f-mono);font-weight:600;color:var(--ink)}
.t-solar{color:var(--solar)}.t-wind{color:var(--wind)}

.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:16px 18px}
.grid{display:grid;gap:16px;grid-template-columns:minmax(0,1fr)}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
@media(max-width:960px){.g2,.g3,.g4{grid-template-columns:1fr}}
.stat{padding:14px 16px}.stat .v{font-family:var(--f-mono);font-size:25px;font-weight:600;letter-spacing:-.02em}
.stat .v small{font-size:13px;color:var(--ink-2);font-weight:500;margin-left:4px}
.stat .l{font-size:12px;color:var(--ink-2);margin-top:2px}

.chip{display:inline-flex;align-items:center;gap:6px;font-family:var(--f-mono);font-size:11px;padding:2px 9px;border-radius:10px;
  border:1px solid var(--line);color:var(--ink-2);background:var(--surface-2);white-space:nowrap}
.chip.ok{color:var(--good);border-color:var(--good)}.chip.bad{color:var(--crit);border-color:var(--crit);background:var(--crit-bg)}
.chip.warn{color:var(--warn);border-color:var(--warn);background:var(--warn-bg)}
.banner{border:1px solid var(--warn);background:var(--warn-bg);color:var(--ink);border-radius:10px;padding:10px 14px;font-size:13px;margin:10px 0}
.banner.crit{border-color:var(--crit);background:var(--crit-bg)}

/* controls: state shown by ink + underline glow, never a filled block */
.seg{display:inline-flex;gap:14px;align-items:center}
.seg button{background:none;border:0;padding:4px 1px;font-size:13px;color:var(--ink-3);cursor:pointer;border-bottom:2px solid transparent;font-weight:500}
.seg button:hover{color:var(--ink-2)}
.seg button.on{color:var(--ink);font-weight:600;border-bottom-color:var(--accent)}
:root[data-theme="dark"] .seg button.on{box-shadow:0 3px 8px -4px var(--glow)}
.controls{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:10px 0 14px}
.controls label{font-size:12px;color:var(--ink-2);display:flex;gap:6px;align-items:center}
select.in,input.in{font:inherit;font-size:13px;padding:5px 8px;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.btn{font-size:13px;padding:7px 14px;border-radius:9px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}
:root[data-theme="dark"] .btn.primary{color:#04121f}
.btn.xs{font-size:11px;padding:3px 8px;border-radius:7px;font-family:var(--f-mono);color:var(--ink-2)}

/* chart card */
.cc-head{display:flex;align-items:flex-start;gap:10px;margin-bottom:6px}
.cc-head h3{margin:0;font-size:14.5px;font-weight:650;flex:1}
.cc-sub{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.cc-tools{display:flex;gap:4px}
.info{width:20px;height:20px;border-radius:50%;border:1px solid var(--line);background:none;color:var(--ink-2);font-size:11px;cursor:pointer;font-family:var(--f-mono)}
.info-text{display:none;font-size:12.5px;color:var(--ink-2);background:var(--surface-2);border-radius:8px;padding:8px 10px;margin-bottom:8px}
.info-text.on{display:block}
.note{font-size:12px;color:var(--ink-2);margin-top:6px}
svg.ch{width:100%;height:auto;display:block;font-family:var(--f-ui)}
svg.ch text{fill:var(--ink-2);font-size:11px}
svg.ch .ax{stroke:var(--line);stroke-width:1}
svg.ch .gridl{stroke:var(--line-soft);stroke-width:1}
svg.ch .ttl{fill:var(--ink-2);font-size:11px;font-weight:600}
svg.ch .lbl{fill:var(--ink);font-family:var(--f-mono);font-size:10.5px}
svg.ch .s-solar{stroke:var(--solar);fill:var(--solar)}svg.ch .s-wind{stroke:var(--wind);fill:var(--wind)}
svg.ch .s-teal{stroke:var(--teal);fill:var(--teal)}svg.ch .s-violet{stroke:var(--violet);fill:var(--violet)}
svg.ch .s-ink{stroke:var(--ink-3);fill:var(--ink-3)}svg.ch .s-accent{stroke:var(--accent);fill:var(--accent)}
svg.ch path.ln.s-faint{stroke:var(--ink-3);opacity:.22;stroke-width:1}
svg.ch path.ln{fill:none;stroke-width:2;stroke-linejoin:round}
svg.ch rect.bar{stroke:none}
svg.ch .mark{stroke:var(--surface);stroke-width:1}
@media(prefers-reduced-motion:no-preference){
  svg.ch path.ln{stroke-dasharray:1;stroke-dashoffset:1;animation:draw .9s ease-out forwards}
  svg.ch rect.bar{transform-box:fill-box;transform-origin:50% 100%;animation:rise .5s ease-out both}
  svg.ch rect.hbar{transform-origin:0 50%;animation-name:grow}
  .card.in{animation:cardin .4s ease-out both}
}
@keyframes draw{to{stroke-dashoffset:0}}@keyframes rise{from{transform:scaleY(0)}}@keyframes grow{from{transform:scaleX(0)}}
@keyframes cardin{from{opacity:0;transform:translateY(7px)}}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-2);margin-top:4px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}

/* landing */
.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:center;padding:14px 0 6px}
@media(max-width:960px){.hero{grid-template-columns:1fr}}
.hero img{max-width:300px;width:100%;justify-self:center}
/* logo lockup: art only, wordmark in HTML below it (same build as the header .wm) */
.lockup{display:flex;flex-direction:column;align-items:center;gap:6px;justify-self:center;width:100%;max-width:300px}
.lockup img{max-width:260px;width:100%}
.lockup .wm{font-size:40px;color:var(--ink)}
.lockup .wm b{color:#1b4f8f}.lockup .wm span{color:#3b4048}
:root[data-theme="dark"] .lockup .wm b{color:#8cc4f5}:root[data-theme="dark"] .lockup .wm span{color:rgba(230,235,241,.72)}
@media(max-width:960px){.lockup .wm{font-size:32px}}
.drop{border:2px dashed var(--line);border-radius:14px;padding:22px;text-align:center;background:var(--surface);margin-top:14px}
.drop.drag{border-color:var(--accent-2);background:var(--surface-2)}
.drop .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:10px}
table.t{width:100%;border-collapse:collapse;font-size:12.5px}
table.t th{text-align:left;color:var(--ink-2);font-weight:600;padding:7px 9px;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface);white-space:nowrap}
table.t td{padding:6px 9px;border-bottom:1px solid var(--line-soft);white-space:nowrap;max-width:260px;overflow:hidden;text-overflow:ellipsis}
table.t tr.sel td{background:var(--surface-2)}
table.t tr.click{cursor:pointer}table.t tr.click:hover td{background:var(--surface-2)}
table.t td.r,table.t th.r{text-align:right;font-family:var(--f-mono)}
.scroll{max-height:420px;overflow:auto;border:1px solid var(--line);border-radius:10px}

/* story */
.chapter{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:22px;align-items:start;padding:26px 0;border-top:1px solid var(--line)}
@media(max-width:960px){.chapter{grid-template-columns:1fr}}
.chapter .no{font-family:var(--f-mono);font-size:11px;color:var(--accent-2);letter-spacing:.12em;font-weight:600}
.chapter p{font-size:15px;color:var(--ink-2);max-width:60ch;margin:8px 0}
.chapter p b{color:var(--ink);font-family:var(--f-mono);font-weight:600}
.absent{font-size:13px;color:var(--ink-3);border:1px dashed var(--line);border-radius:10px;padding:14px}

/* cluster tab */
pre.code{font-family:var(--f-mono);font-size:12px;line-height:1.55;background:var(--surface-2);border:1px solid var(--line-soft);border-radius:8px;padding:10px 12px;margin:0;overflow:auto;color:var(--ink)}
#cl-body.stale{opacity:.55}
svg.ch .cl-n{fill:#fff;font-family:var(--f-mono);font-size:11px;font-weight:600;paint-order:stroke;stroke:#04121f;stroke-width:2.6px;stroke-linejoin:round}
svg.ch path.ln.s-new{stroke:var(--accent);stroke-width:2.4}
svg.ch path.ln.s-old{stroke:var(--violet);stroke-width:1.6;stroke-dasharray:.012 .008}
/* layers + map */
.stage{position:relative;background:#04080e;border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.stage canvas{display:block;width:100%;height:660px}
.lay-list{display:flex;flex-direction:column;gap:8px}
.lay{border:1px solid var(--line);border-radius:10px;padding:9px 12px;background:var(--surface);cursor:default}
.lay.hot{border-color:var(--accent)}
.lay.cfg{border-style:dashed}
.lay h4{margin:0;font-size:13px;display:flex;align-items:center;gap:8px}
.lay h4 i{width:10px;height:10px;border-radius:2px;display:inline-block}
.lay p{margin:3px 0 0;font-size:12px;color:var(--ink-2)}
#map{height:620px;border-radius:14px;border:1px solid var(--line);background:var(--surface-2)}
.mapwrap{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:16px}
@media(max-width:960px){.mapwrap{grid-template-columns:1fr}}
.ramp{height:10px;border-radius:5px;margin:6px 0 2px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:2px 12px;font-size:12.5px}
.kv span:nth-child(odd){color:var(--ink-2)}.kv span:nth-child(even){font-family:var(--f-mono);text-align:right}
.leaflet-container{font-family:var(--f-ui)}
.tree{font-family:var(--f-mono);font-size:12px;line-height:1.6}
.tree details{margin-left:14px}.tree summary{cursor:pointer;color:var(--ink)}
.tree .leaf{margin-left:14px;color:var(--ink-2)}.tree .leaf b{color:var(--ink);font-weight:500}
.about p{max-width:80ch;color:var(--ink-2);font-size:14.5px}
.about iframe{width:100%;height:640px;border:1px solid var(--line);border-radius:14px;background:#070b12}
.flow{display:flex;gap:8px;flex-wrap:wrap;align-items:stretch;margin:12px 0}
.flow div{flex:1;min-width:150px;border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--surface)}
.flow div b{display:block;font-size:13px}.flow div span{font-size:12px;color:var(--ink-2)}
footer{max-width:1280px;margin:0 auto;padding:16px 22px 30px;color:var(--ink-3);font-size:12px;border-top:1px solid var(--line)}
.scrim{position:fixed;inset:0;background:rgba(4,10,18,.55);display:none;align-items:center;justify-content:center;z-index:2000}
.modal-box{max-width:560px}.modal-box h3{margin:0 0 8px;font-size:16px}.modal-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
table.t tr.grp td{background:var(--surface-2);font-weight:600;white-space:normal}
.scrim.on{display:flex}.scrim>div{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 22px;font-size:13.5px;box-shadow:var(--shadow)}


/* ---------- RESource loader (logo_loader.svg; see assets/logo/logo_src/README.md) ---------- */
.rd-loader{position:fixed;inset:0;z-index:5000;display:grid;place-items:center;
  background:rgba(7,11,18,.28);
  -webkit-backdrop-filter:blur(10px) saturate(1.15);backdrop-filter:blur(10px) saturate(1.15);
  opacity:0;visibility:hidden;transition:opacity .18s ease,visibility 0s linear .18s}
.rd-loader.on{opacity:1;visibility:visible;transition:opacity .18s ease}
.rd-loader .box{display:flex;flex-direction:column;align-items:center;gap:12px;
  transform:scale(.94);transition:transform .22s cubic-bezier(.2,.9,.3,1.2)}
.rd-loader.on .box{transform:scale(1)}
.rd-loader img{width:112px;height:112px;filter:drop-shadow(0 6px 18px rgba(0,16,32,.35))}
.rd-loader .msg{font:600 12px/1 'JetBrains Mono',ui-monospace,Consolas,monospace;letter-spacing:.06em;
  color:#fff;padding:7px 14px;border-radius:20px;background:rgba(4,18,31,.55);border:1px solid rgba(140,198,63,.45)}
.rd-loader .msg::after{content:"";display:inline-block;width:1.4em;text-align:left;animation:rd-dots 1.2s steps(4) infinite}
@keyframes rd-dots{0%{content:""}25%{content:"."}50%{content:".."}75%{content:"..."}}
@media (prefers-reduced-motion:reduce){.rd-loader,.rd-loader .box{transition:none}.rd-loader .msg::after{animation:none}}
.vleg button{display:inline-flex;align-items:center;gap:6px;font:inherit;font-size:12px;color:inherit;background:none;border:1px solid var(--line);border-radius:12px;padding:2px 9px;cursor:pointer}
.vleg button:hover{border-color:var(--accent)}.vleg button.off{opacity:.42;text-decoration:line-through}.vleg button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
.tip{display:inline-grid;place-items:center;width:17px;height:17px;border-radius:50%;border:1px solid var(--line);color:var(--ink-3);font:italic 600 11px/1 Georgia,serif;cursor:help;position:relative;vertical-align:middle;margin-left:4px;background:var(--surface);user-select:none}
.tip:hover,.tip:focus{color:var(--accent);border-color:var(--accent);outline:none}
.tip::after{content:attr(data-tip);position:absolute;left:50%;top:calc(100% + 8px);transform:translateX(-50%);width:max-content;max-width:300px;padding:8px 11px;border-radius:8px;background:var(--ink);color:var(--bg);font:400 12.5px/1.45 var(--f-ui);text-align:left;letter-spacing:0;white-space:normal;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:opacity .15s;z-index:3000}
.tip:hover::after,.tip:focus::after{opacity:1}
h1 .tip{vertical-align:.35em}
.reload-last{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px;padding:8px 10px 8px 12px;border:1px solid var(--line);border-left:3px solid var(--accent-2);border-radius:10px;background:var(--surface)}
.reload-last .small{flex:1;min-width:140px}
.iconx{border:0;background:none;color:var(--ink-3);cursor:pointer;font-size:13px;padding:4px 6px;border-radius:6px}.iconx:hover{color:var(--crit);background:var(--surface-2)}
.help-tour{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:10px 0 16px}
.help-tour h3{margin:0 0 2px}.help-tour p{margin:0}.help-tour .row{display:flex;align-items:center;gap:14px}
.help-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px}
.help-tab{display:flex;flex-direction:column;gap:3px;text-align:left;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}
.help-tab:hover{border-color:var(--accent)}.help-tab span{font-size:12.5px;color:var(--ink-2);line-height:1.4}
.help-list{margin:6px 0 0;padding-left:18px;line-height:1.7}
.tour{position:fixed;inset:0;z-index:6000;pointer-events:none}
.tour-spot{position:fixed;border-radius:10px;box-shadow:0 0 0 9999px rgba(4,12,22,.58),0 0 0 3px #8cc63f;transition:all .45s cubic-bezier(.3,.9,.3,1)}
.tour-cap{position:fixed;pointer-events:auto;background:var(--surface);color:var(--ink);border-radius:12px;padding:14px 16px 10px;box-shadow:0 10px 30px rgba(0,0,0,.35);transition:left .45s,top .45s;font-size:14.5px;line-height:1.5}
