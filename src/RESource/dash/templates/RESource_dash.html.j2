        const top = Object.entries(regs).sort((a, b) => sum(Object.values(b[1])) - sum(Object.values(a[1]))).slice(0, 12);
        chapter('Installable capacity', `<p>${both((t) => `Developable land carries <b>${F.gw(S[t].capacity_mw)}</b> of <span class="t-${t}">${t}</span>${has(S[t], 'developable_km2') && S[t].developable_km2 > 0 ? `, an implied density of <b>${F.n(S[t].capacity_mw / S[t].developable_km2, 2)} MW/km²</b>` : ''}.`).join(' ')}</p>
          <p>Capacity sits in <b>${both((t) => `${F.n(S[t].cells_with_capacity)} ${t}`).join(' and ')}</b> cells. This is technical potential on screened land. It is not a build-out forecast.</p>`,
          CH.card({ title: `Potential capacity by ${rc}`, svg: CH.bars({ cats: top.map((r) => r[0].slice(0, 9)), series: both((t) => ({ name: RD.techName(t), cls: 's-' + t, vals: top.map((r) => r[1][t]) })), yLabel: 'Potential capacity (GW)', unit: 'GW', labels: true }),
            legend: both((t) => [RD.techName(t), t]), chips: top.length < Object.keys(regs).length ? [`top 12 of ${Object.keys(regs).length}`] : [], info: 'Bars share one GW axis, so solar and wind compare directly. Wind usually leads because its land-use intensity per km² is higher, not because the land is better.',
